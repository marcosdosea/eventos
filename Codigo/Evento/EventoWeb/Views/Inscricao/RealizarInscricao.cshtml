@model EventoWeb.Models.InscricaoEventoViewModel

@{
    ViewData["Title"] = "Inscrição - " + Model.eventoNavigation.Nome;
}

<link rel="stylesheet" href="~/css/realizarInscricao.css" asp-append-version="true" />

<main class="inscricao-page">
    @if (TempData["ParticipanteSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ParticipanteSuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ParticipanteMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["ParticipanteMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="inscricao-container inscricao-container-top">
        @if (ViewBag.JaInscrito == true)
        {
            <div class="inscricao-grid-layout">
                <!-- Coluna da Esquerda: Informações do Evento -->
                <div class="inscricao-left-col">
                    <partial name="_EventoInfoCard" model="Model.eventoNavigation" />
                </div>

                <!-- Coluna da Direita: Já Inscrito -->
                <div class="inscricao-right-col">
                    <aside class="alert alert-info mt-3 card-inscricao text-center alert-inscricao" role="alert">
                        <h4 class="alert-heading text-info">Atenção!</h4>
                        <p>Você já está inscrito neste evento.</p>
                        @if (!string.IsNullOrWhiteSpace(Model.inscricaoNavigation?.NomeCracha))
                        {
                            <p class="mb-2"><strong>Nome no crachá:</strong> @Model.inscricaoNavigation.NomeCracha</p>
                        }
                        <hr>
                        <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-idEvento="@Model.eventoNavigation.Id" class="btn btn-success mt-2">Ver Inscrição / Comprovante</a>
                        <a asp-action="MinhasInscricoes" asp-controller="Inscricao" class="btn btn-primary mt-2 ms-2">Ver Minhas Inscrições</a>
                        <a href="@ViewBag.UrlVoltar" class="btn btn-outline-danger mt-2 ms-2">Voltar</a>
                    </aside>
                </div>
            </div>

            @if (Model.SubeventosOpcoes != null && Model.SubeventosOpcoes.Any())
            {
                <partial name="_SubeventosCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "IsForm", false } }' />
            }
        }
        else if (Model.eventoNavigation.VagasDisponiveis <= 0 && ViewBag.JaInscritoEventoPrincipal != true)
        {
            <div class="inscricao-grid-layout">
                <div class="inscricao-left-col">
                    <partial name="_EventoInfoCard" model="Model.eventoNavigation" />
                </div>
                <div class="inscricao-right-col">
                    <aside class="alert alert-warning mt-3 card-inscricao text-center alert-inscricao" role="alert">
                        <h4 class="alert-heading text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Lotação Esgotada</h4>
                        <p>As inscrições para este evento estão com lotação esgotada.</p>
                        <hr>
                        <a href="@ViewBag.UrlVoltar" class="btn btn-outline-danger mt-2">Voltar</a>
                    </aside>
                </div>
            </div>

            @if (Model.SubeventosOpcoes != null && Model.SubeventosOpcoes.Any())
            {
                <partial name="_SubeventosCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "IsForm", false } }' />
            }
        }
        else if ((ViewBag.InscricaoFutura == true || (Model.eventoNavigation.DataInicioInscricao.HasValue && Model.eventoNavigation.DataInicioInscricao.Value > DateTime.Now)) && ViewBag.JaInscritoEventoPrincipal != true)
        {
            <div class="inscricao-grid-layout">
                <!-- Coluna da Esquerda: Informações do Evento -->
                <div class="inscricao-left-col">
                    <partial name="_EventoInfoCard" model="Model.eventoNavigation" />
                </div>

                <partial name="_InscricaoEmBreveCard" model="Model.eventoNavigation.DataInicioInscricao" />
            </div>

            @if (Model.SubeventosOpcoes != null && Model.SubeventosOpcoes.Any())
            {
                <partial name="_SubeventosCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "IsForm", false } }' />
            }
        }
        else
        {
            <form method="post" asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@Model.eventoNavigation.Id">
                <div class="inscricao-grid-layout">
                    <!-- Coluna da Esquerda: Informações do Evento -->
                    <div class="inscricao-left-col">
                        <partial name="_EventoInfoCard" model="Model.eventoNavigation" />
                    </div>

                    <!-- Coluna da Direita: Opções e Formulário -->
                    <div class="inscricao-right-col">
                        <section class="card-inscricao">
                            @if (ViewBag.JaInscritoEventoPrincipal == true)
                            {
                                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                                    <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                                    <div>
                                        <strong>Você já está inscrito no Evento Principal!</strong>
                                        <p class="mb-0">Selecione abaixo os subeventos adicionais dos quais deseja participar.</p>
                                    </div>
                                </div>
                                <input type="hidden" name="JaInscritoNoPrincipal" id="JaInscritoNoPrincipal" value="true" />
                                <input type="hidden" id="NomeCracha" name="NomeCracha" value="@Model.inscricaoNavigation?.NomeCracha" />
                            }
                            else
                            {
                                <h2 class="section-title">Opções de Inscrição</h2>
                                <p class="section-description">
                                    Selecione o tipo de inscrição desejado:
                                </p>

                                <fieldset class="subevent-list">
                                    <legend class="visually-hidden">Escolha seu tipo de inscrição</legend>
                                    @if (Model.tipoInscricao != null && Model.tipoInscricao.Any())
                                    {
                                        foreach (var item in Model.tipoInscricao)
                                        {
                                            <label class="subevent-item">
                                                <div class="subevent-info">
                                                    <h4>@item.Nome</h4>
                                                    <p>@item.Descricao</p>
                                                    @if(item.Valor == 0)
                                                    {
                                                        <span class="badge-custom badge-success">Gratuito</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-custom badge-primary">R$ @item.Valor.ToString("N2")</span>
                                                    }
                                                </div>
                                                <div class="checkbox-wrapper">
                                                    <input type="radio" name="IdTipoInscricao" value="@item.Id" data-valor="@item.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)" onchange="toggleSelect(this)" required aria-label="Selecionar @item.Nome" />
                                                </div>
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">Nenhum tipo de inscrição configurado para este evento. A inscrição padrão será aplicada.</div>
                                        <input type="hidden" name="IdTipoInscricao" value="0" />
                                    }
                                </fieldset>

                                <div class="mt-4 mb-3">
                                    <label for="NomeCracha" class="form-label fw-bold">Nome no Crachá</label>
                                    <input type="text" id="NomeCracha" name="NomeCracha" value="@Model.inscricaoNavigation?.NomeCracha" class="form-control" maxlength="20" placeholder="Como deseja ser chamado no crachá" />
                                    <small class="form-text text-muted">Informe o nome a ser impresso no crachá (máximo de 20 caracteres).</small>
                                </div>
                            }

                            <footer class="summary">
                                <div>
                                    <p class="summary-title">Valor Total Estimado</p>
                                    <div class="price-total" aria-live="polite">
                                        @if (ViewBag.JaInscritoEventoPrincipal == true)
                                        {
                                            @:Gratuito
                                        }
                                        else if (Model.eventoNavigation.InscricaoGratuita == 1 || Model.eventoNavigation.ValorInscricao == 0)
                                        {
                                            @:Gratuito
                                        }
                                        else
                                        {
                                            @:R$ @Model.eventoNavigation.ValorInscricao.ToString("N2")
                                        }
                                    </div>
                                </div>
                                <div class="actions-wrapper">
                                    <a href="@ViewBag.UrlVoltar" class="btn-voltar">Voltar</a>
                                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <button type="submit" class="btn-submit">@(ViewBag.JaInscritoEventoPrincipal == true ? "Confirmar Inscrição no(s) Subevento(s)" : "Confirmar Inscrição")</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-submit btn-login" onclick="window.location.href='/Identity/Account/Login?ReturnUrl=@Url.Action("RealizarInscricao", "Inscricao", new { idEvento = Model.eventoNavigation.Id })'">Faça Login para Confirmar</button>
                                    }
                                </div>
                            </footer>
                        </section>
                    </div>
                </div>

                @if (Model.SubeventosOpcoes != null && Model.SubeventosOpcoes.Any())
                {
                    <partial name="_SubeventosCard" model="Model" view-data='new ViewDataDictionary(ViewData) { { "IsForm", true } }' />
                }
            </form>
        }
    </div>

    <!-- Modal de Imagem -->
    <div id="imageModal" class="image-modal" onclick="closeImageModal()">
        <span class="image-modal-close" onclick="closeImageModal()">&times;</span>
        <img class="image-modal-content" id="expandedImg">
    </div>

    <!-- Modal de Ementa do Subevento -->
    <div id="ementaModalOverlay" class="modal-ementa-overlay" onclick="fecharEmentaModal(event)">
        <div class="modal-ementa-card" onclick="event.stopPropagation()">
            <div class="modal-ementa-header">
                <h5 class="modal-ementa-title" id="ementaModalTitulo">Ementa do Subevento</h5>
                <button type="button" class="modal-ementa-close" onclick="fecharEmentaModal()">&times;</button>
            </div>
            <div class="modal-ementa-body">
                <div class="modal-ementa-meta">
                    <span class="modal-ementa-meta-item">
                        <i class="bi bi-tag-fill blue-normal"></i>
                        <span id="ementaModalTipo"></span>
                    </span>
                    <span class="modal-ementa-meta-item">
                        <i class="bi bi-clock-fill blue-normal"></i>
                        <span id="ementaModalCarga"></span>
                    </span>
                </div>
                <div id="ementaModalDescricao" style="white-space: pre-line;"></div>
            </div>
            <div class="modal-ementa-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill" onclick="fecharEmentaModal()">Fechar</button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/realizarInscricao.js" asp-append-version="true"></script>
}
