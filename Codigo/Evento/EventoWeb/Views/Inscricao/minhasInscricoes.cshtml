@model IEnumerable<EventoWeb.Models.InscricaoEventoModel>;
@{
    ViewData["Title"] = "Minhas Inscrições & Quitação de Eventos";
    ViewData["RodapeCompleto"] = true;
    var culturaBr = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var nomeParticipante = ViewBag.NomeParticipante as string;
    var cpfMascarado = ViewBag.CpfMascarado as string;
    var totalRegistros = ViewBag.TotalRegistros as int? ?? Model.Count();
    var paginaAtual = ViewBag.PaginaAtual as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 1;
    var idEventoRota = ViewBag.IdEventoRota as uint?;
}

<style>
    .mi-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .mi-titulo { color: #0d47d9; font-weight: 700; font-size: 2.4rem; line-height: 1.15; margin-bottom: .75rem; }
    .mi-subtitulo { color: #4a5568; max-width: 640px; margin: 0; }
    .mi-participante { display: flex; gap: .5rem; padding: .5rem; background: #eef2fb; border-radius: 12px; }
    .mi-participante-nome { background: #fff; border-radius: 8px; padding: .5rem .9rem; font-size: .85rem; font-weight: 600; display: flex; align-items: center; gap: .5rem; }
    .mi-participante-nome .ponto { width: 8px; height: 8px; border-radius: 50%; background: #1d4ed8; flex-shrink: 0; }
    .mi-participante-nome strong { color: #1d4ed8; }
    .mi-participante-cpf { background: #dde6fa; border-radius: 8px; padding: .5rem .9rem; font-size: .78rem; font-weight: 600; color: #374151; }
    .mi-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(15, 23, 42, .06); padding: 1.25rem 1rem; }
    .mi-card-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .mi-card-titulo { font-size: 1.3rem; font-weight: 600; margin: 0; color: #111827; display: flex; align-items: center; gap: .5rem; }
    .mi-card-titulo i { color: #1d4ed8; }
    .mi-contador { background: #eef2fb; color: #374151; border-radius: 999px; padding: .25rem .8rem; font-size: .8rem; font-weight: 600; display: inline-flex; align-items: center; gap: .4rem; }
    .mi-contador .ponto { width: 8px; height: 8px; border-radius: 50%; background: #1d4ed8; }
    .mi-tabela { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .9rem; }
    .mi-tabela thead th { background: #e8edf9; color: #111827; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; padding: .8rem .5rem; vertical-align: middle; text-align: center; }
    .mi-tabela thead th:first-child { border-top-left-radius: 10px; border-bottom-left-radius: 10px; padding-left: .75rem; }
    .mi-tabela thead th:last-child { border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-right: .75rem; }
    .mi-tabela tbody td { padding: 1rem .5rem; vertical-align: middle; border-bottom: 1px solid #eef0f4; text-align: center; }
    .mi-tabela .mi-col-evento { text-align: left; }
    .mi-tabela thead th.mi-col-evento { width: 24%; }
    .mi-tabela tbody td:first-child { padding-left: .75rem; }
    .mi-tabela tbody td:last-child { padding-right: .75rem; }
    .mi-tabela tbody tr:last-child td { border-bottom: none; }
    .mi-data { white-space: nowrap; }
    .mi-protocolo { color: #1d4ed8; font-weight: 600; white-space: nowrap; }
    .mi-protocolo.confirmado { color: #111827; }
    .mi-evento-nome { font-weight: 600; color: #111827; }
    .mi-evento-local { font-size: .82rem; color: #6b7280; margin-top: .25rem; }
    .mi-col-evento { min-width: 190px; }
    .mi-subeventos { margin-top: .65rem; padding: .5rem .75rem; background: #f5f7fd; border-left: 3px solid #c7d4f5; border-radius: 0 8px 8px 0; }
    .mi-subeventos-titulo { display: block; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; margin-bottom: .35rem; }
    .mi-subeventos ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .4rem; }
    .mi-subeventos li { display: flex; align-items: flex-start; gap: .4rem; font-size: .82rem; line-height: 1.3; }
    .mi-subeventos li > i { color: #1d4ed8; font-size: .8rem; margin-top: .1rem; flex-shrink: 0; }
    .mi-sub-info { display: flex; flex-direction: column; min-width: 0; }
    .mi-sub-nome { color: #374151; font-weight: 500; overflow-wrap: anywhere; }
    .mi-sub-valor { color: #6b7280; font-size: .76rem; white-space: nowrap; }
    .mi-valor { font-weight: 600; white-space: nowrap; }
    .mi-status { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .6rem; border-radius: 999px; font-size: .74rem; font-weight: 600; white-space: nowrap; }
    .mi-status-pendente { background: #fef3c7; color: #92400e; }
    .mi-status-confirmado { background: #dcfce7; color: #166534; }
    .mi-status-cancelado { background: #f1f3f5; color: #6c757d; }
    .mi-indisponivel { color: #6b7280; font-size: .8rem; }
    .mi-btn-pdf { background: #e8edf9; color: #1d4ed8; border: none; font-weight: 600; font-size: .78rem; white-space: nowrap; }
    .mi-btn-pdf:hover { background: #d6e0f7; color: #1d4ed8; }
    .mi-acoes { display: flex; flex-direction: column; align-items: center; gap: .4rem; }
    .mi-acoes-botoes { display: flex; flex-direction: column; align-items: center; gap: .4rem; }
    .mi-acoes .btn { display: inline-flex; align-items: center; gap: .35rem; font-weight: 600; white-space: nowrap; }
    .mi-link-acao { color: #1d4ed8; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; background: none; border: none; padding: 0; white-space: nowrap; }
    .mi-link-acao:hover { text-decoration: underline; }
    .mi-link-acao:disabled { color: #9ca3af; cursor: not-allowed; text-decoration: none; }
    .mi-paginacao { display: flex; justify-content: flex-end; align-items: center; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
    .mi-paginacao-info { color: #4b5563; font-size: .85rem; font-weight: 600; }
    .cert-status { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .65rem; border-radius: 999px;
                   font-size: .75rem; font-weight: 500; border: 1px solid transparent; white-space: nowrap; }
    .cert-neutro  { background: #f1f3f5; color: #6c757d; border-color: #dee2e6; }
    .cert-info    { background: #e7f1ff; color: #0a58ca; border-color: #b6d4fe; }
    .cert-alerta  { background: #fff4e0; color: #b45309; border-color: #fcd9a0; }
    .cert-sucesso { background: #e6f6ec; color: #146c43; border-color: #a3d9b8; }
</style>

<div class="mi-header">
    <div>
        <h1 class="mi-titulo">@ViewData["Title"]</h1>
        <p class="mi-subtitulo">
            Gerencie suas credenciais, pendências financeiras e efetue o pagamento online com liberação imediata de acesso e crachá digital.
        </p>
    </div>
    @if (!string.IsNullOrWhiteSpace(nomeParticipante) || !string.IsNullOrWhiteSpace(cpfMascarado))
    {
        <div class="mi-participante">
            @if (!string.IsNullOrWhiteSpace(nomeParticipante))
            {
                <div class="mi-participante-nome">
                    <span class="ponto" aria-hidden="true"></span>
                    <span>Participante: <strong>@nomeParticipante</strong></span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(cpfMascarado))
            {
                <div class="mi-participante-cpf">CPF:<br />@cpfMascarado</div>
            }
        </div>
    }
</div>

@if (TempData["ParticipanteSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="text-success m-0">
            <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> @TempData["ParticipanteSuccessMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["ParticipanteErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="text-danger m-0 fw-semibold">
            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i> @TempData["ParticipanteErrorMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["ParticipanteMessage"] != null && TempData["ParticipanteErrorMessage"] == null)
{
    <div class="alert alert-info alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="m-0">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i> @TempData["ParticipanteMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
{
    <div class="mb-3">
        <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
            &larr; Voltar para Inscrição do Evento
        </a>
    </div>
}

<section class="mi-card" aria-labelledby="tituloHistorico">
    <div class="mi-card-header">
        <h2 id="tituloHistorico" class="mi-card-titulo">
            <i class="bi bi-receipt" aria-hidden="true"></i> Histórico de Inscrições do Usuário
        </h2>
        <span class="mi-contador">
            <span class="ponto" aria-hidden="true"></span>
            @totalRegistros @(totalRegistros == 1 ? "Registro Localizado" : "Registros Localizados")
        </span>
    </div>

    <div class="table-responsive">
        <table id="tableEvento" class="mi-tabela">
            <thead>
                <tr>
                    <th scope="col">Protocolo / Inscrição</th>
                    <th scope="col" class="mi-col-evento">Evento</th>
                    <th scope="col">Data da Inscrição</th>
                    <th scope="col">Valor Total</th>
                    <th scope="col">Status do Pagamento</th>
                    <th scope="col">Comprovante</th>
                    <th scope="col">Pagamento</th>
                    <th scope="col">Credencial</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (totalRegistros == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Nenhuma inscrição encontrada.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var evento = item.IdEventoNavigation;
                    var subeventos = item.Inscricaopessoasubeventos?.ToList() ?? new List<Core.Inscricaopessoasubevento>();
                    var valorTotalGeral = item.ValorTotal + subeventos.Sum(s => s.Valor);
                    var protocolo = item.Id > 0 ? $"#INS-{item.DataInscricao.Year}-{item.Id:D4}" : (subeventos.Any() ? $"#SUB-{subeventos.First().DataInscricao.Year}-{subeventos.First().Id:D4}" : "-");
                    var semCusto = valorTotalGeral <= 0;
                    var confirmado = item.Status == "A" || (item.Status == "S" && semCusto);
                    var pendente = item.Status == "S" && !semCusto;
                    var cancelado = item.Status == "C";

                    var localPartes = new List<string>();
                    if (evento != null)
                    {
                        if (!string.IsNullOrWhiteSpace(evento.Rua))
                        {
                            localPartes.Add(string.IsNullOrWhiteSpace(evento.Numero) ? evento.Rua : $"{evento.Rua}, {evento.Numero}");
                        }
                        else if (!string.IsNullOrWhiteSpace(evento.Bairro))
                        {
                            localPartes.Add(evento.Bairro);
                        }
                        var cidadeUf = string.Join(", ", new[] { evento.Cidade, evento.Estado }.Where(p => !string.IsNullOrWhiteSpace(p)));
                        if (!string.IsNullOrWhiteSpace(cidadeUf))
                        {
                            localPartes.Add(cidadeUf);
                        }
                    }

                    <tr>
                        <td>
                            <span class="mi-protocolo @(confirmado ? "confirmado" : "")">@protocolo</span>
                        </td>
                        <td class="mi-col-evento">
                            <div class="mi-evento-nome">@(evento?.Nome ?? "Evento")</div>
                            @if (localPartes.Any())
                            {
                                <div class="mi-evento-local">@string.Join(" • ", localPartes)</div>
                            }
                            @if (subeventos.Any())
                            {
                                <div class="mi-subeventos">
                                    <span class="mi-subeventos-titulo">@(subeventos.Count == 1 ? "Subevento" : "Subeventos")</span>
                                    <ul>
                                        @foreach (var sub in subeventos)
                                        {
                                            var subConfirmado = sub.Status == "A" || (sub.Status == "S" && sub.Valor <= 0);
                                            <li>
                                                <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                                                <div class="mi-sub-info">
                                                    <span class="mi-sub-nome">@(sub.IdSubEventoNavigation?.Nome ?? "Subevento")</span>
                                                    <span class="mi-sub-valor">@sub.Valor.ToString("C", culturaBr)</span>
                                                </div>
                                                @if (confirmado && subConfirmado)
                                                {
                                                    var subJaOcorreu = (sub.IdSubEventoNavigation != null) && (
                                                        (sub.IdSubEventoNavigation.DataFim != DateTime.MinValue && sub.IdSubEventoNavigation.DataFim < DateTime.Now) ||
                                                        (sub.IdSubEventoNavigation.DataFim == DateTime.MinValue && sub.IdSubEventoNavigation.DataInicio != DateTime.MinValue && sub.IdSubEventoNavigation.DataInicio < DateTime.Now) ||
                                                        sub.IdSubEventoNavigation.Status == "F" || sub.IdSubEventoNavigation.Status == "I"
                                                    );

                                                    @if (subJaOcorreu)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary p-1 ms-auto text-nowrap"
                                                              style="font-size: 0.72rem; line-height: 1;"
                                                              title="Não é possível transferir a titularidade de um subevento que já aconteceu ou foi encerrado.">
                                                            <i class="bi bi-clock-history" aria-hidden="true"></i> Encerrado
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary p-1 ms-auto text-nowrap btn-abrir-modal-transferir"
                                                                style="font-size: 0.72rem; line-height: 1;"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalTransferirIngresso"
                                                                data-id-inscricao="0"
                                                                data-id-subevento="@sub.IdSubEvento"
                                                                data-nome-evento="@(evento?.Nome ?? "Evento")"
                                                                data-nome-subevento="@(sub.IdSubEventoNavigation?.Nome ?? "Subevento")"
                                                                data-protocolo="@protocolo"
                                                                title="Transferir titularidade deste subevento">
                                                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Transferir
                                                        </button>
                                                    }
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </td>
                        <td class="mi-data">@item.DataInscricao.ToString("dd/MM/yyyy")</td>
                        <td><span class="mi-valor">@valorTotalGeral.ToString("C", culturaBr)</span></td>
                        <td>
                            @if (confirmado)
                            {
                                <span class="mi-status mi-status-confirmado"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Confirmado</span>
                            }
                            else if (pendente)
                            {
                                <span class="mi-status mi-status-pendente"><i class="bi bi-clock" aria-hidden="true"></i> Pendente</span>
                            }
                            else if (cancelado)
                            {
                                <span class="mi-status mi-status-cancelado"><i class="bi bi-slash-circle" aria-hidden="true"></i> Cancelado</span>
                            }
                            else
                            {
                                <span class="mi-status mi-status-cancelado">-</span>
                            }
                        </td>
                        <td>
                            @if (confirmado && item.Id > 0)
                            {
                                <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-id="@item.Id" class="btn btn-sm mi-btn-pdf">
                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Ver Recibo
                                </a>
                            }
                            else
                            {
                                <span class="mi-indisponivel">Indisponível</span>
                            }
                        </td>
                        <td>
                            @if (pendente)
                            {
                                <button type="button" class="btn btn-sm btn-primary text-nowrap" disabled
                                        title="Pagamento online ainda não disponível">
                                    <i class="bi bi-credit-card" aria-hidden="true"></i> Pagar Agora
                                </button>
                            }
                            else if (confirmado && semCusto)
                            {
                                <span class="mi-indisponivel">Gratuito</span>
                            }
                            else if (confirmado)
                            {
                                <span class="mi-indisponivel">Pago</span>
                            }
                            else
                            {
                                <span class="mi-indisponivel">-</span>
                            }
                        </td>
                        <td>
                            @if (confirmado)
                            {
                                <button type="button" class="mi-link-acao text-nowrap" disabled title="Credencial digital ainda não disponível">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i> Credencial
                                </button>
                            }
                            else
                            {
                                <span class="mi-indisponivel">Indisponível</span>
                            }
                        </td>
                        <td>
                            <div class="mi-acoes">
                                <div class="mi-acoes-botoes">
                                    @if (confirmado && item.Id > 0)
                                    {
                                        var eventoJaOcorreu = (evento != null) && (
                                            (evento.DataFim.HasValue && evento.DataFim.Value < DateTime.Now) ||
                                            (!evento.DataFim.HasValue && evento.DataInicio.HasValue && evento.DataInicio.Value < DateTime.Now) ||
                                            evento.Status == "F" || evento.Status == "C"
                                        );

                                        @if (eventoJaOcorreu)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" disabled
                                                    title="Não é possível transferir a titularidade de um evento que já aconteceu ou foi encerrado.">
                                                <i class="bi bi-clock-history" aria-hidden="true"></i> Evento Encerrado
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap btn-abrir-modal-transferir"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalTransferirIngresso"
                                                    data-id-inscricao="@item.Id"
                                                    data-id-subevento=""
                                                    data-nome-evento="@(evento?.Nome ?? "Evento")"
                                                    data-protocolo="@protocolo">
                                                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Transferir Titularidade
                                            </button>
                                        }
                                    }
                                    @if (item.Id == 0 && subeventos.Any())
                                    {
                                        <span class="badge bg-light text-secondary border p-2" title="Você não possui o ingresso do evento principal, apenas inscrições em subeventos.">
                                            <i class="bi bi-diagram-2 me-1" aria-hidden="true"></i> Apenas Subevento(s)
                                        </span>
                                    }
                                    @if (!confirmado && item.Id > 0)
                                    {
                                        <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-id="@item.Id" class="mi-link-acao">
                                            <i class="bi bi-eye" aria-hidden="true"></i> Ver Inscrição
                                        </a>
                                    }
                                    else if (!confirmado && item.IdEvento > 0)
                                    {
                                        <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-idEvento="@item.IdEvento" class="mi-link-acao">
                                            <i class="bi bi-eye" aria-hidden="true"></i> Ver Inscrição
                                        </a>
                                    }
                                    @if (item.IdPapel == 4 && evento != null && evento.Status == "A"
                                        && (!evento.DataInicio.HasValue || evento.DataInicio.Value > DateTime.Now)
                                        && (!evento.DataFim.HasValue || evento.DataFim.Value >= DateTime.Now))
                                    {
                                        <form asp-action="CancelarInscricao" asp-controller="Inscricao" method="post" class="d-inline"
                                              onsubmit="return confirm('Deseja desistir da inscrição neste evento? Sua vaga será liberada.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idEvento" value="@item.IdEvento" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Desistir
                                            </button>
                                        </form>
                                    }
                                </div>
                                @switch (item.StatusCertificado)
                                {
                                    case StatusCertificadoInscricao.SemCertificado:
                                        <span class="cert-status cert-neutro" title="Este evento não emite certificado"><i class="bi bi-dash-circle" aria-hidden="true"></i> Sem certificado</span>
                                        break;
                                    case StatusCertificadoInscricao.EmAndamento:
                                        <span class="cert-status cert-info" title="Disponível após o encerramento do evento"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Em andamento</span>
                                        break;
                                    case StatusCertificadoInscricao.FrequenciaInsuficiente:
                                        <span class="cert-status cert-alerta" title="Frequência obtida: @(item.FrequenciaFinal.ToString("F1"))% | mínima exigida: @(evento?.FrequenciaMinimaCertificado.ToString("F1"))%"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Frequência insuficiente</span>
                                        break;
                                    case StatusCertificadoInscricao.Elegivel:
                                        <span class="cert-status cert-sucesso" title="Requisitos atendidos para certificação"><i class="bi bi-patch-check" aria-hidden="true"></i> Elegível</span>
                                        break;
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="mi-paginacao" aria-label="Paginação das inscrições">
            @if (paginaAtual > 1)
            {
                <a asp-action="minhasInscricoes" asp-controller="Inscricao" asp-route-idEvento="@idEventoRota" asp-route-pagina="@(paginaAtual - 1)"
                   class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
                </a>
            }
            <span class="mi-paginacao-info" aria-current="page">Página @paginaAtual de @totalPaginas</span>
            @if (paginaAtual < totalPaginas)
            {
                <a asp-action="minhasInscricoes" asp-controller="Inscricao" asp-route-idEvento="@idEventoRota" asp-route-pagina="@(paginaAtual + 1)"
                   class="btn btn-sm btn-primary">
                    Próximo <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            }
        </nav>
    }
</section>

<div class="mt-4 d-flex gap-2 flex-wrap">
    @if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
    {
        <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
            &larr; Voltar para Inscrição do Evento
        </a>
    }
    <a asp-action="Index" asp-controller="Home" asp-route-vitrine="true" class="btn btn-outline-secondary">
        Voltar para Início
    </a>
</div>

<!-- Modal Transferir Titularidade -->
<div class="modal fade" id="modalTransferirIngresso" tabindex="-1" aria-labelledby="modalTransferirIngressoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title d-flex align-items-center gap-2" id="modalTransferirIngressoLabel">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Transferir Titularidade
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form asp-action="TransferirIngresso" asp-controller="Inscricao" method="post" id="formTransferirIngresso" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdInscricao" id="transferirIdInscricao" value="0" />
                <input type="hidden" name="IdSubevento" id="transferirIdSubevento" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-light border mb-3">
                        <div class="small text-muted text-uppercase fw-bold mb-1">Ingresso Selecionado</div>
                        <div class="fw-bold text-dark" id="transferirDescricaoIngresso">-</div>
                        <div class="small text-muted" id="transferirProtocolo">-</div>
                        <div class="small text-primary mt-1 fw-semibold" id="transferirAlertaSeparacao">A transferência de evento e subevento ocorre separadamente.</div>
                    </div>

                    <div class="mb-3">
                        <label for="CpfAmigo" class="form-label fw-semibold">CPF do Destinatário <span class="text-danger">*</span></label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
                            <input type="text" class="form-control" id="CpfAmigo" name="CpfAmigo" maxlength="14" required
                                   placeholder="000.000.000-00" autocomplete="off" />
                            <div class="invalid-feedback" id="feedbackCpfAmigo">
                                Informe um CPF válido com 11 dígitos.
                            </div>
                        </div>
                        <div class="form-text">Digite os 11 números do CPF. Buscaremos o cadastro automaticamente.</div>
                    </div>

                    <div id="alertaDestinatarioCpf" class="alert d-none mb-3 py-2 px-3 small" role="alert"></div>

                    <div class="mb-3">
                        <label for="NomeAmigo" class="form-label fw-semibold">Nome no Crachá / Destinatário <span class="text-danger">*</span></label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <input type="text" class="form-control" id="NomeAmigo" name="NomeAmigo" maxlength="20" required
                                   placeholder="Nome no crachá (máx. 20)" autocomplete="off" />
                            <div class="invalid-feedback" id="feedbackNomeAmigo">
                                Informe o nome no crachá (entre 2 e 20 caracteres).
                            </div>
                        </div>
                        <div class="form-text">Nome a constar na credencial/crachá do amigo (máximo de 20 caracteres).</div>
                    </div>

                    <div class="mb-3">
                        <label for="EmailAmigo" class="form-label fw-semibold">E-mail do Destinatário <span class="text-danger">*</span></label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <input type="email" class="form-control" id="EmailAmigo" name="EmailAmigo" maxlength="100" required
                                   placeholder="amigo@email.com" autocomplete="off" />
                            <div class="invalid-feedback" id="feedbackEmailAmigo">
                                Informe um endereço de e-mail válido (ex: amigo@email.com).
                            </div>
                        </div>
                        <div class="form-text">Enviaremos a confirmação, o ingresso e as instruções de acesso para este e-mail.</div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted border">
                        <i class="bi bi-info-circle-fill text-primary me-1" aria-hidden="true"></i>
                        Se o amigo ainda não possuir conta no Boralá, criaremos uma conta para ele com este CPF e enviaremos por e-mail as instruções de primeiro acesso.
                        Após a confirmação, o ingresso será transferido e deixará de constar no seu painel.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" id="btnConfirmarTransferencia">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Confirmar Transferência
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modalElement = document.getElementById('modalTransferirIngresso');
        if (!modalElement) return;

        var form = document.getElementById('formTransferirIngresso');
        var cpfInput = document.getElementById('CpfAmigo');
        var nomeInput = document.getElementById('NomeAmigo');
        var emailInput = document.getElementById('EmailAmigo');
        var alertaDest = document.getElementById('alertaDestinatarioCpf');
        var btnSubmit = document.getElementById('btnConfirmarTransferencia');
        var feedbackCpf = document.getElementById('feedbackCpfAmigo');
        var feedbackNome = document.getElementById('feedbackNomeAmigo');
        var feedbackEmail = document.getElementById('feedbackEmailAmigo');

        var ultimoCpfConsultado = '';
        var destinatarioEhMesmoUsuario = false;
        var destinatarioExiste = false;
        var emailCadastradoDestinatario = '';
        var emailMascaradoCadastrado = '';

        function validarCpf(cpf) {
            if (!cpf) return false;
            var strCPF = cpf.replace(/\D/g, '');
            if (strCPF.length !== 11) return false;
            if (/^(\d)\1{10}$/.test(strCPF)) return false;

            var soma = 0;
            var resto;
            for (var i = 1; i <= 9; i++) {
                soma += parseInt(strCPF.substring(i - 1, i)) * (11 - i);
            }
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(strCPF.substring(9, 10))) return false;

            soma = 0;
            for (var i = 1; i <= 10; i++) {
                soma += parseInt(strCPF.substring(i - 1, i)) * (12 - i);
            }
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(strCPF.substring(10, 11))) return false;

            return true;
        }

        function validarEmail(email) {
            if (!email) return false;
            var trimmed = email.trim();
            var regex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            return regex.test(trimmed);
        }

        function validarNome(nome) {
            if (!nome) return false;
            var trimmed = nome.trim();
            return trimmed.length >= 2 && trimmed.length <= 20;
        }

        function checarCampoCpf() {
            var raw = cpfInput.value.replace(/\D/g, '');
            if (!raw) {
                cpfInput.classList.remove('is-valid');
                cpfInput.classList.add('is-invalid');
                if (feedbackCpf) feedbackCpf.textContent = 'O CPF do destinatário é obrigatório.';
                return false;
            }
            if (raw.length !== 11 || !validarCpf(raw)) {
                cpfInput.classList.remove('is-valid');
                cpfInput.classList.add('is-invalid');
                if (feedbackCpf) feedbackCpf.textContent = 'Informe um CPF válido com 11 dígitos.';
                return false;
            }
            if (destinatarioEhMesmoUsuario) {
                cpfInput.classList.remove('is-valid');
                cpfInput.classList.add('is-invalid');
                if (feedbackCpf) feedbackCpf.textContent = 'Você não pode transferir um ingresso para você mesmo.';
                return false;
            }
            cpfInput.classList.remove('is-invalid');
            cpfInput.classList.add('is-valid');
            return true;
        }

        function checarCampoNome() {
            var v = nomeInput.value;
            if (!v || !v.trim()) {
                nomeInput.classList.remove('is-valid');
                nomeInput.classList.add('is-invalid');
                if (feedbackNome) feedbackNome.textContent = 'O nome no crachá é obrigatório.';
                return false;
            }
            if (!validarNome(v)) {
                nomeInput.classList.remove('is-valid');
                nomeInput.classList.add('is-invalid');
                if (feedbackNome) feedbackNome.textContent = 'O nome no crachá deve ter entre 2 e 20 caracteres.';
                return false;
            }
            nomeInput.classList.remove('is-invalid');
            nomeInput.classList.add('is-valid');
            return true;
        }

        function checarCampoEmail() {
            var v = emailInput.value;
            if (!v || !v.trim()) {
                emailInput.classList.remove('is-valid');
                emailInput.classList.add('is-invalid');
                if (feedbackEmail) feedbackEmail.textContent = 'O e-mail é obrigatório.';
                return false;
            }
            if (!validarEmail(v)) {
                emailInput.classList.remove('is-valid');
                emailInput.classList.add('is-invalid');
                if (feedbackEmail) feedbackEmail.textContent = 'Informe um e-mail válido (ex: amigo@email.com).';
                return false;
            }
            if (destinatarioExiste && emailCadastradoDestinatario && !emailCadastradoDestinatario.endsWith('@@borala.com.br')) {
                if (v.trim().toLowerCase() !== emailCadastradoDestinatario) {
                    emailInput.classList.remove('is-valid');
                    emailInput.classList.add('is-invalid');
                    if (feedbackEmail) {
                        feedbackEmail.textContent = 'O e-mail deve ser o mesmo cadastrado (' + (emailMascaradoCadastrado || emailCadastradoDestinatario) + ').';
                    }
                    return false;
                }
            }
            emailInput.classList.remove('is-invalid');
            emailInput.classList.add('is-valid');
            return true;
        }

        modalElement.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) return;

            var idInscricao = button.getAttribute('data-id-inscricao') || '0';
            var idSubevento = button.getAttribute('data-id-subevento') || '';
            var nomeEvento = button.getAttribute('data-nome-evento') || 'Evento';
            var nomeSubevento = button.getAttribute('data-nome-subevento') || '';
            var protocolo = button.getAttribute('data-protocolo') || '';

            document.getElementById('transferirIdInscricao').value = idInscricao || '0';
            document.getElementById('transferirIdSubevento').value = idSubevento || '';

            var descElement = document.getElementById('transferirDescricaoIngresso');
            var separacaoElement = document.getElementById('transferirAlertaSeparacao');
            if (nomeSubevento) {
                descElement.textContent = 'Subevento: ' + nomeSubevento + ' (' + nomeEvento + ')';
                if (separacaoElement) {
                    separacaoElement.textContent = 'Apenas este subevento será transferido. O evento principal e demais subeventos permanecerão com você.';
                }
            } else {
                descElement.textContent = 'Evento Principal: ' + nomeEvento;
                if (separacaoElement) {
                    separacaoElement.textContent = 'Apenas o ingresso do evento principal será transferido. Os seus subeventos permanecerão com você.';
                }
            }

            document.getElementById('transferirProtocolo').textContent = protocolo ? 'Protocolo: ' + protocolo : '';
            nomeInput.value = '';
            cpfInput.value = '';
            emailInput.value = '';

            [cpfInput, nomeInput, emailInput].forEach(function (el) {
                el.classList.remove('is-invalid', 'is-valid');
            });

            if (alertaDest) {
                alertaDest.className = 'alert d-none mb-3 py-2 px-3 small';
                alertaDest.innerHTML = '';
            }

            ultimoCpfConsultado = '';
            destinatarioEhMesmoUsuario = false;
            destinatarioExiste = false;
            emailCadastradoDestinatario = '';
            emailMascaradoCadastrado = '';
            if (btnSubmit) {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check2-circle" aria-hidden="true"></i> Confirmar Transferência';
            }
        });

        function consultarDestinatario(cpfNumeros) {
            if (!cpfNumeros || cpfNumeros.length !== 11 || cpfNumeros === ultimoCpfConsultado) return;
            if (!validarCpf(cpfNumeros)) return;
            ultimoCpfConsultado = cpfNumeros;

            if (alertaDest) {
                alertaDest.className = 'alert alert-light border mb-3 py-2 px-3 small text-muted';
                alertaDest.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Consultando cadastro no sistema...';
                alertaDest.classList.remove('d-none');
            }

            var baseUrl = '@Url.Action("ConsultarDestinatarioTransferencia", "Inscricao")';
            if (!baseUrl || baseUrl === '') {
                baseUrl = '/Inscricao/ConsultarDestinatarioTransferencia';
            }
            var url = baseUrl + (baseUrl.indexOf('?') >= 0 ? '&' : '?') + 'cpf=' + encodeURIComponent(cpfNumeros);

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (r) {
                    if (!r.ok) {
                        throw new Error('HTTP ' + r.status);
                    }
                    return r.json();
                })
                .then(function (data) {
                    if (!alertaDest) return;
                    if (data.sucesso && data.existe) {
                        destinatarioExiste = true;
                        destinatarioEhMesmoUsuario = false;
                        emailCadastradoDestinatario = (data.email || '').trim().toLowerCase();
                        emailMascaradoCadastrado = data.emailMascarado || '';

                        var nomeCracha = (data.nomeCracha || data.nome || '').trim();
                        if (nomeCracha.length > 20) {
                            nomeCracha = nomeCracha.substring(0, 20);
                        }

                        alertaDest.className = 'alert alert-info border mb-3 py-2 px-3 small';
                        alertaDest.innerHTML = '<i class="bi bi-person-check-fill text-primary me-1"></i> Participante cadastrado: <strong>' + (data.nomeCompleto || nomeCracha) + '</strong>.<br/>Nome no crachá e e-mail preenchidos automaticamente.';
                        alertaDest.classList.remove('d-none');

                        if (nomeInput && nomeCracha) {
                            nomeInput.value = nomeCracha;
                            checarCampoNome();
                        }
                        if (emailInput && data.email) {
                            emailInput.value = data.email;
                            checarCampoEmail();
                        }
                        checarCampoCpf();
                    } else if (data.sucesso && !data.existe) {
                        destinatarioExiste = false;
                        destinatarioEhMesmoUsuario = false;
                        emailCadastradoDestinatario = '';
                        emailMascaradoCadastrado = '';

                        alertaDest.className = 'alert alert-secondary border mb-3 py-2 px-3 small';
                        alertaDest.innerHTML = '<i class="bi bi-person-plus-fill me-1"></i> <strong>Novo participante:</strong> Nenhuma conta encontrada para este CPF no sistema. Preencha o nome no crachá e e-mail abaixo para enviarmos as instruções de primeiro acesso.';
                        alertaDest.classList.remove('d-none');
                        checarCampoCpf();
                    } else if (!data.sucesso && data.mesmoUsuario) {
                        destinatarioEhMesmoUsuario = true;
                        emailCadastradoDestinatario = '';
                        emailMascaradoCadastrado = '';

                        alertaDest.className = 'alert alert-danger border mb-3 py-2 px-3 small';
                        alertaDest.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + data.mensagem;
                        alertaDest.classList.remove('d-none');
                        checarCampoCpf();
                    } else {
                        alertaDest.className = 'alert alert-warning border mb-3 py-2 px-3 small';
                        alertaDest.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> ' + (data.mensagem || 'Não foi possível consultar o cadastro.');
                        alertaDest.classList.remove('d-none');
                        destinatarioEhMesmoUsuario = false;
                        emailCadastradoDestinatario = '';
                        emailMascaradoCadastrado = '';
                    }
                })
                .catch(function (err) {
                    console.error('Erro na consulta de destinatário:', err);
                    if (alertaDest) {
                        alertaDest.className = 'alert alert-warning border mb-3 py-2 px-3 small';
                        alertaDest.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Não foi possível consultar o cadastro automaticamente. Você pode preencher os dados manualmente.';
                        alertaDest.classList.remove('d-none');
                    }
                });
        }

        if (cpfInput) {
            cpfInput.addEventListener('input', function (e) {
                var v = e.target.value.replace(/\D/g, '');
                if (v.length > 11) v = v.substring(0, 11);
                if (v.length > 9) {
                    v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
                } else if (v.length > 6) {
                    v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
                } else if (v.length > 3) {
                    v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
                }
                e.target.value = v;

                var raw = v.replace(/\D/g, '');
                if (raw.length === 11) {
                    if (validarCpf(raw)) {
                        consultarDestinatario(raw);
                        checarCampoCpf();
                    } else {
                        cpfInput.classList.remove('is-valid');
                        cpfInput.classList.add('is-invalid');
                        if (feedbackCpf) feedbackCpf.textContent = 'Número de CPF inválido.';
                        if (alertaDest) alertaDest.classList.add('d-none');
                    }
                } else {
                    cpfInput.classList.remove('is-valid', 'is-invalid');
                    if (alertaDest) {
                        alertaDest.classList.add('d-none');
                        ultimoCpfConsultado = '';
                    }
                    destinatarioEhMesmoUsuario = false;
                    emailCadastradoDestinatario = '';
                    emailMascaradoCadastrado = '';
                }
            });

            cpfInput.addEventListener('paste', function () {
                setTimeout(function () {
                    var raw = cpfInput.value.replace(/\D/g, '');
                    if (raw.length === 11 && validarCpf(raw)) {
                        consultarDestinatario(raw);
                        checarCampoCpf();
                    }
                }, 50);
            });

            cpfInput.addEventListener('blur', function () {
                var valido = checarCampoCpf();
                var raw = cpfInput.value.replace(/\D/g, '');
                if (valido && raw.length === 11) {
                    consultarDestinatario(raw);
                }
            });
        }

        if (nomeInput) {
            nomeInput.addEventListener('blur', function () {
                checarCampoNome();
            });
            nomeInput.addEventListener('input', function () {
                if (nomeInput.classList.contains('is-invalid')) {
                    checarCampoNome();
                }
            });
        }

        if (emailInput) {
            emailInput.addEventListener('blur', function () {
                checarCampoEmail();
            });
            emailInput.addEventListener('input', function () {
                if (emailInput.classList.contains('is-invalid')) {
                    checarCampoEmail();
                }
            });
        }

        if (form) {
            form.addEventListener('submit', function (e) {
                var cpfValido = checarCampoCpf();
                var nomeValido = checarCampoNome();
                var emailValido = checarCampoEmail();

                var idInscricao = document.getElementById('transferirIdInscricao').value;
                var idSubevento = document.getElementById('transferirIdSubevento').value;
                var temIngresso = (idInscricao && idInscricao !== '0') || (idSubevento && idSubevento !== '0');

                if (!temIngresso) {
                    alert('Erro: nenhum ingresso ou subevento selecionado para transferência.');
                    e.preventDefault();
                    return;
                }

                if (!cpfValido || !nomeValido || !emailValido || destinatarioEhMesmoUsuario) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (!cpfValido || destinatarioEhMesmoUsuario) {
                        cpfInput.focus();
                    } else if (!nomeValido) {
                        nomeInput.focus();
                    } else if (!emailValido) {
                        emailInput.focus();
                    }
                    return;
                }

                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Transferindo...';
                }
            });
        }
    });
</script>
