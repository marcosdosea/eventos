@model IEnumerable<EventoWeb.Models.InscricaoEventoModel>;
@{
    ViewData["Title"] = "Minhas Inscrições";
}

<style>
    .acoes-inscricao { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; }
    .acoes-inscricao-botoes { display: flex; align-items: center; gap: .5rem; }
    .acoes-inscricao .btn { display: inline-flex; align-items: center; gap: .35rem; font-weight: 500; }
    .cert-status { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .65rem; border-radius: 999px;
                   font-size: .78rem; font-weight: 500; border: 1px solid transparent; white-space: nowrap; }
    .cert-neutro  { background: #f1f3f5; color: #6c757d; border-color: #dee2e6; }
    .cert-info    { background: #e7f1ff; color: #0a58ca; border-color: #b6d4fe; }
    .cert-alerta  { background: #fff4e0; color: #b45309; border-color: #fcd9a0; }
    .cert-sucesso { background: #e6f6ec; color: #146c43; border-color: #a3d9b8; }
</style>

<h1 class="blue-normal">@ViewData["Title"]</h1>
<hr />

@if (TempData["ParticipanteSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="text-success m-0">
            @TempData["ParticipanteSuccessMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ParticipanteMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="m-0">
            @TempData["ParticipanteMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
{
    <div class="mb-3">
        <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
            &larr; Voltar para Inscrição do Evento
        </a>
    </div>
}

<div>
    <table id="tableEvento" class="table table-striped table-bordered dt-responsive nowrap">
        <thead>
            <tr class="blue-normal blue-normal-bg-table">
                <th>
                    Evento
                </th>
                <th>
                    Nome no Crachá
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DataInscricao)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ValorTotal)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FrequenciaFinal)
                </th>
                <th>
                    Ações
                </th>
            </tr>
        </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    Nenhuma inscrição encontrada.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td style="vertical-align: middle;">
                    <strong>@(item.IdEventoNavigation?.Nome ?? "Evento")</strong>
                </td>
                <td style="vertical-align: middle;">
                    @(!string.IsNullOrWhiteSpace(item.NomeCracha) ? item.NomeCracha : "-")
                </td>
                <td style="vertical-align: middle;">
                    @{
                        var status = "Padrão";
                        switch(item.Status) {
                            case "A":
                            status = "Ativo";
                            break;
                            case "S":
                            status = "Solicitado";
                            break;
                            case "C":
                            status = "Cancelado";
                            break;    
                        }
                    }
                @status
                </td>
                <td style="vertical-align: middle;">
                    @item.DataInscricao.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td style="vertical-align: middle;">
                    @item.ValorTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                </td>
                <td style="vertical-align: middle;">
                    @Html.DisplayFor(modelItem => item.FrequenciaFinal)
                </td>
                <td style="vertical-align: middle;">
                    <div class="acoes-inscricao">
                        <div class="acoes-inscricao-botoes">
                            @if (item.Id > 0)
                            {
                                <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            }
                            else if (item.IdEvento > 0)
                            {
                                <a asp-action="DetalhesInscricao" asp-controller="Inscricao" asp-route-idEvento="@item.IdEvento" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            }
                            @if (item.IdPapel == 4 && item.IdEventoNavigation != null && item.IdEventoNavigation.Status == "A"
                                && (!item.IdEventoNavigation.DataInicio.HasValue || item.IdEventoNavigation.DataInicio.Value > DateTime.Now)
                                && (!item.IdEventoNavigation.DataFim.HasValue || item.IdEventoNavigation.DataFim.Value >= DateTime.Now))
                            {
                                <form asp-action="CancelarInscricao" asp-controller="Inscricao" method="post" class="d-inline"
                                      onsubmit="return confirm('Deseja desistir da inscrição neste evento? Sua vaga será liberada.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idEvento" value="@item.IdEvento" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle"></i> Desistir
                                    </button>
                                </form>
                            }
                        </div>
                        @switch (item.StatusCertificado)
                        {
                            case StatusCertificadoInscricao.SemCertificado:
                                <span class="cert-status cert-neutro" title="Este evento não emite certificado"><i class="bi bi-dash-circle"></i> Sem certificado</span>
                                break;
                            case StatusCertificadoInscricao.EmAndamento:
                                <span class="cert-status cert-info" title="Disponível após o encerramento do evento"><i class="bi bi-hourglass-split"></i> Em andamento</span>
                                break;
                            case StatusCertificadoInscricao.FrequenciaInsuficiente:
                                <span class="cert-status cert-alerta" title="Frequência obtida: @(item.FrequenciaFinal.ToString("F1"))% | mínima exigida: @(item.IdEventoNavigation?.FrequenciaMinimaCertificado.ToString("F1"))%"><i class="bi bi-exclamation-triangle"></i> Frequência insuficiente</span>
                                break;
                            case StatusCertificadoInscricao.Elegivel:
                                <span class="cert-status cert-sucesso" title="Requisitos atendidos para certificação"><i class="bi bi-patch-check"></i> Elegível</span>
                                break;
                            case StatusCertificadoInscricao.Cancelada:
                                <span class="cert-status cert-neutro"><i class="bi bi-slash-circle"></i> Inscrição cancelada</span>
                                break;
                        }
                    </div>
                </td>
            </tr>
            @if (item.Inscricaopessoasubeventos != null && item.Inscricaopessoasubeventos.Any())
            {
                foreach (var sub in item.Inscricaopessoasubeventos)
                {
                    <tr class="table-light">
                        <td style="vertical-align: middle; padding-left: 2rem;">
                            <span class="badge bg-secondary me-1">Subevento</span>
                            @(sub.IdSubEventoNavigation?.Nome ?? "Subevento")
                        </td>
                        <td style="vertical-align: middle;" class="text-center text-muted">
                            -
                        </td>
                        <td style="vertical-align: middle;">
                            @{
                                var statusSub = "Padrão";
                                switch(sub.Status) {
                                    case "A": statusSub = "Ativo"; break;
                                    case "S": statusSub = "Solicitado"; break;
                                    case "C": statusSub = "Cancelado"; break;
                                }
                            }
                            @statusSub
                        </td>
                        <td style="vertical-align: middle;">
                            @sub.DataInscricao.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td style="vertical-align: middle;">
                            @sub.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                        </td>
                        <td style="vertical-align: middle;">
                            @sub.FrequenciaFinal
                        </td>
                        <td style="vertical-align: middle; text-align: center;">
                            <span class="text-muted">-</span>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
    </table>
    
    <div class="mt-4 d-flex gap-2">
        @if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
        {
            <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
                &larr; Voltar para Inscrição do Evento
            </a>
        }
        <a asp-action="Index" asp-controller="Home" asp-route-vitrine="true" class="btn btn-outline-secondary">
            Voltar para Início
        </a>
    </div>
</div>