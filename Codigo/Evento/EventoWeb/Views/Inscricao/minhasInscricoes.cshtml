@model IEnumerable<EventoWeb.Models.InscricaoEventoModel>;
@{
    ViewData["Title"] = "Minhas Inscrições";
}

<h1 class="blue-normal">@ViewData["Title"]</h1>
<hr />

@if (TempData["ParticipanteSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="text-success m-0">
            @TempData["ParticipanteSuccessMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ParticipanteMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show position-relative" role="alert" style="padding-right: 2rem;">
        <div class="m-0">
            @TempData["ParticipanteMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
{
    <div class="mb-3">
        <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
            &larr; Voltar para Inscrição do Evento
        </a>
    </div>
}

<div>
    <table id="tableEvento" class="table table-striped table-bordered dt-responsive nowrap">
        <thead>
            <tr class="blue-normal blue-normal-bg-table">
                <th>
                    @Html.DisplayNameFor(model => model.IdEventoNavigation.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DataInscricao)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FrequenciaFinal)
                </th>
                <th>
                    Ações
                </th>
            </tr>
        </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="vertical-align: middle;">
                    @Html.DisplayFor(modelItem => item.IdEventoNavigation.Nome)
                </td>
                <td style="vertical-align: middle;">
                    @{
                        var status = "Padrão";
                        switch(item.Status) {
                            case "A":
                            status = "Ativo";
                            break;
                            case "S":
                            status = "Solicitado";
                            break;
                            case "C":
                            status = "Cancelado";
                            break;    
                        }
                    }
                @status
                </td>
                <td style="vertical-align: middle;">
                    @Html.DisplayFor(modelItem => item.DataInscricao)
                </td>
                <td style="vertical-align: middle;">
                    @Html.DisplayFor(modelItem => item.FrequenciaFinal)
                </td>
                <td style="vertical-align: middle;">
                    @if (item.IdEvento > 0)
                    {
                        <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@item.IdEvento" class="btn btn-sm btn-outline-primary me-2">
                            Ver Inscrição
                        </a>
                    }
                    <span class="text-muted">Gerar Certificado</span>
                </td>
            </tr>
        }
    </tbody>
    </table>
    
    <div class="mt-4 d-flex gap-2">
        @if (ViewBag.EventoId != null && (uint)ViewBag.EventoId > 0)
        {
            <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@ViewBag.EventoId" class="btn btn-primary">
                &larr; Voltar para Inscrição do Evento
            </a>
        }
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
            Voltar para Início
        </a>
    </div>
</div>