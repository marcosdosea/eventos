@model EventoWeb.Models.ParticipacaoPessoaSubEventoModel

@{
    ViewData["Title"] = "Remover Participante do Sub-Evento";
}

<div class="container-fluid no-padding">
    <div class="row">
        <h1 class="blue-normal">Remover Participante do Sub-Evento</h1>
        <div>
            <h3>Tem certeza que deseja remover este participante?</h3>
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.NomePessoa)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.NomePessoa)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.NomeSubEvento)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.NomeSubEvento)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Entrada)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Entrada)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Saida)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Saida)
                </dd>
            </dl>
            <div class="text-danger fw-bold small mb-3">
                Essa operação não pode ser desfeita.
            </div>
        </div>
        <form asp-action="DeleteConfirmed"
              asp-route-id="@Model.Id"
              asp-route-idSubEvento="@Model.IdSubEvento"
              method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end">
                <div class="d-flex flex-row">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="submit" value="Remover" class="btn btn-danger" />
                    </div>
                    <div class="form-group">
                        <a asp-action="Index" asp-route-idSubEvento="@Model.IdSubEvento" class="btn btn-outline-primary">Cancelar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

