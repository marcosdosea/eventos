<!DOCTYPE html>

@{

    var eventoId = ViewData["EventoId"]?.ToString();

    if (string.IsNullOrEmpty(eventoId))
    {
        eventoId = Context.Request.Query["idEvento"].ToString();
    }

    if (string.IsNullOrEmpty(eventoId))
    {
        eventoId = ViewContext.RouteData.Values["idEvento"]?.ToString();
    }

    if (string.IsNullOrEmpty(eventoId))
    {
        eventoId = ViewContext.RouteData.Values["id"]?.ToString();
    }
}

<html lang="pt-BR">


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/css/headerAndFooter.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css">
</head>

<body>
    <header class="p-3 mb-3 border-bottom">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center">
                    @{
                        var isGerenciarEventoListar = ViewContext.RouteData.Values["controller"]?.ToString() == "Evento" && 
                                                      ViewContext.RouteData.Values["action"]?.ToString() == "GerenciarEventoListar";
                    }
                    @if (!isGerenciarEventoListar)
                    {
                        <button class="navbar-toggler navbar-light custom-toggler me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                    <div class="logo">
                        <a href="@Url.Action("Index", "Home", new { area = "", vitrine = true })" title="Ir para a vitrine dos eventos">
                            <img src="/img/LOGOTIPO.png" alt="Logotipo" />
                        </a>
                    </div>
                </div>
                @if (!isGerenciarEventoListar)
                {
                    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body">
                            @if (User.Identity.IsAuthenticated && User.IsInRole("GESTOR"))
                            {
                                <ul class="navbar-nav justify-content-start flex-grow-1 pe-3">
                                        <li class="nav-item">
                                            <a class="nav-link active titulo">Gestor do Evento</a>
                                        </li>
                                        @if (possuiEvento)
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Evento" asp-action="GerenciarEventoListar">
                                                    Eventos
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Participacaopessoaevento" asp-action="Index" asp-route-idEvento="@eventoId">Inscrições</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Evento" asp-action="CreateColaborador" asp-route-idEvento="@eventoId">Colaboradores</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Evento" asp-action="GerenciarEvento" asp-route-idEvento="@eventoId">Detalhes do Evento</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Participante" asp-action="Index" asp-route-idEvento="@eventoId">Usuários</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Subevento" asp-action="Index" asp-route-idEvento="@eventoId">SubEventos</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="TipoInscricao" asp-action="Index" asp-route-idEvento="@eventoId">Tipo Inscrição </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Modelocracha" asp-action="Index" asp-route-idEvento="@eventoId">Modelo Crachá</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Modelocertificado" asp-action="Index" asp-route-idEvento="@eventoId">Modelo Certificado</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Evento" asp-action="CreateParticipante" asp-route-idEvento="@eventoId">Participantes</a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link opcao" asp-controller="Evento" asp-action="GerenciarEventoListar">Eventos</a>
                                            </li>
                                        }
                                </ul>
                            }
                        </div>
                    </div>
                }


                <div class="flex-shrink-0 dropdown align-content-center">
                    <a href="#" class="d-block link-dark text-decoration-none dropdown-toggle" id="dropdownUser2" data-bs-toggle="dropdown" aria-expanded="false">
                        Olá, @ViewBag.NomeUsuario!
                        <img src="/img/img-user.svg" alt="User" width="32" height="32" class="rounded-circle ms-2">
                    </a>
                    <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser2">
                        @if (User.IsInRole("ADMINISTRADOR"))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Evento" asp-action="GerenciarEventoListar">Gerenciar Evento</a>
                            </li>
                        }
                        <li>
                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Gerenciar Conta</a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button id="logout" type="submit" class="dropdown-item">Sair</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <div class="container conteudo">
        <main role="main" class="pb-3">
            @if (User.IsInRole("GESTOR"))
            {
                <div id="gestorEventosContainer">
                    @await Html.PartialAsync("_GestorEventosList", new List<EventoWeb.Models.EventoModel>())
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show position-relative alert-dismissible-custom" role="alert">
                    <div class="text-success m-0">
                        @TempData["SuccessMessage"]
                    </div>

                    <button type="button" class="btn-close-custom" data-bs-dismiss="alert" aria-label="Close">
                        &times;
                    </button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="container footer">
        <div class="container">
            &copy; @DateTime.Now.Year
        </div>
    </footer>

    <!-- Scripts na ordem correta -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/formHelpers.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>