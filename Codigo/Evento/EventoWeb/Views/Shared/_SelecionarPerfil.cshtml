@model string
@{
    ViewData["Title"] = "Alterar Perfil";
}

<div class="modal fade" id="modalEscolherPerfil" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                <h5 class="modal-title w-100 text-center">Selecione o seu perfil de acesso</h5>
                </div>
                <div class="modal-body text-center py-4">
                <div class="container-fluid">
                    <p class="mb-4">Você possui mais de um cargo, para acessar o sistema selecione como você quer entrar.</p>
                    <form class="row g-2 justify-content-center" asp-action="SelecionarPerfil" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@ViewBag.UserId" />
                            @if (User.IsInRole("ADMINISTRADOR"))
                            {
                            <div class="col-12 col-sm-6 col-lg-3">
                            <button type="submit" name="perfil" value="ADMINISTRADOR" class="btn btn-outline-primary  btn-lg fw-bold d-flex flex-column align-items-center w-100">
                                <img alt="icone do usuario" src="/img/user.svg" onerror="this.style.display='none';"  class="img-fluid mb-2" />
                                <span>Administrador</span>
                            </button>
                            </div>
                            }
                            @if (User.IsInRole("GESTOR"))
                            {
                            <div class="col-12 col-sm-6 col-lg-3">
                             <button type="submit" name="perfil" value="GESTOR" class="btn btn-outline-success btn-lg fw-bold d-flex flex-column align-items-center w-100">
                                <img alt="icone do gestor" src="/img/user.svg" onerror="this.style.display='none';" class="img-fluid mb-2" />
                                <span>Gestor</span>
                             </button>
                            </div>
                            }
                            @if (User.IsInRole("USUARIO"))
                            {
                            <div class="col-12 col-sm-6 col-lg-3">
                            <button type="submit" name="perfil" value="USUARIO" class="btn btn-outline-secondary btn-lg fw-bold d-flex flex-column align-items-center w-100">
                                <img alt="icone do usuario" src="/img/user.svg" onerror="this.style.display='none';" class="img-fluid mb-2 " />
                                <span>Usuario</span>
                            </button>
                            </div>
                            }
                            @if (User.IsInRole("COLABORADOR"))
                            {
                           <div class="col-12 col-sm-6 col-lg-3">
                            <button type="submit" name="perfil" value="COLABORADOR" class="btn btn-outline-warning btn-lg fw-bold d-flex flex-column align-items-center w-100">
                                <img alt="icone do colaborador" src="/img/user.svg" onerror="this.style.display='none';" class="img-fluid mb-2" />
                                <span>Colaborador</span>
                            </button>
                            </div>
                            }
                    </form>
                </div>
                <br />
                <i class="bi bi-info-circle">Você poderá alterar seu perfil de acesso depois.</i>
               </div>
            </div>    
    </div>
</div>


