@model EventoWeb.Models.SubeventoModel

@{
    var isEdicao = Model.Id != 0;
    ViewData["Title"] = isEdicao ? "Editar Subevento" : "Cadastro de Subevento";

    var eventoId = Model.IdEvento != 0 ? Model.IdEvento : (Model.Evento?.Id ?? 0);
    var eventoNome = !string.IsNullOrWhiteSpace(Model.Evento?.Nome)
        ? Model.Evento.Nome
        : (!string.IsNullOrWhiteSpace(Model.NomeEvento) ? Model.NomeEvento : "Evento não informado");
    var culturaPtBr = new System.Globalization.CultureInfo("pt-BR");
}

<link rel="stylesheet" href="~/css/subevento.css" asp-append-version="true" />

<div class="subevento-page-container">
    <nav class="subevento-breadcrumb" aria-label="Navegação estrutural">
        <a asp-controller="Evento" asp-action="GerenciarEvento" asp-route-idEvento="@eventoId">
            <i class="bi bi-house-door me-1"></i>Gerenciar Evento
        </a>
        <i class="bi bi-chevron-right small"></i>
        <a asp-controller="Subevento" asp-action="Index" asp-route-idEvento="@eventoId">Subeventos</a>
        <i class="bi bi-chevron-right small"></i>
        <span class="subevento-breadcrumb-active">@(isEdicao ? "Editar Subevento" : "Novo Subevento")</span>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="subevento-title">@ViewData["Title"]</h1>
            <p class="subevento-subtitle">
                @(isEdicao
                    ? "Atualize os dados, agenda, vagas e regras de certificação desta atividade"
                    : "Crie minicursos, oficinas, palestras ou mesas-redondas vinculadas ao evento principal")
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="subevento-event-badge" title="Evento principal vinculado">
                <i class="bi bi-calendar-event"></i>
                <span>@eventoNome</span>
            </span>
            <a asp-controller="Subevento" asp-action="Index" asp-route-idEvento="@eventoId" class="subevento-back-btn">
                <i class="bi bi-arrow-left"></i>
                <span>Voltar aos Subeventos</span>
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                <div>
                    <div class="fw-semibold">Não foi possível salvar o subevento.</div>
                    <div class="small">Revise os campos destacados abaixo e tente novamente.</div>
                    <div asp-validation-summary="ModelOnly" class="small mt-1 mb-0"></div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <form asp-action="CreateOrEdit"
          asp-route-idEvento="@eventoId"
          asp-route-idSubevento="@(isEdicao ? (uint?)Model.Id : null)"
          method="post"
          id="formSubevento">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdEvento" value="@eventoId" />
        <input type="hidden" name="Evento.Id" value="@eventoId" />

        <div class="row g-4 align-items-start">
            <div class="col-lg-8 d-flex flex-column gap-4">
                <section class="subevento-card">
                    <div class="subevento-card-header">
                        <div class="subevento-card-icon">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <div>
                            <h2 class="subevento-card-title">Informações da Atividade</h2>
                            <p class="subevento-card-subtitle">Dados exibidos na grade de programação e inscrição do participante</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Nome" class="subevento-label">
                                <i class="bi bi-card-heading"></i>
                                <span>Nome do Subevento</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <input asp-for="Nome" class="form-control subevento-input" placeholder="Ex.: Minicurso de Arquitetura Limpa em ASP.NET Core" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="IdTipoEvento" class="subevento-label">
                                <i class="bi bi-bookmark"></i>
                                <span>Tipo de Subevento</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <select asp-for="IdTipoEvento" class="form-select subevento-select" asp-items="Model.TiposEventos">
                                <option value="">Selecione o tipo</option>
                            </select>
                            <span asp-validation-for="IdTipoEvento" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descricao" class="subevento-label">
                                <i class="bi bi-text-left"></i>
                                <span>Descrição / Ementa</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <textarea asp-for="Descricao" class="form-control subevento-input" rows="4" placeholder="Descreva os objetivos, tópicos abordados ou pré-requisitos do subevento"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>
                    </div>
                </section>

                <section class="subevento-card">
                    <div class="subevento-card-header">
                        <div class="subevento-card-icon">
                            <i class="bi bi-calendar-range"></i>
                        </div>
                        <div>
                            <h2 class="subevento-card-title">Agenda e Janela de Inscrições</h2>
                            <p class="subevento-card-subtitle">Deve respeitar o intervalo de datas configurado no evento principal</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DataInicio" class="subevento-label">
                                <i class="bi bi-calendar-check"></i>
                                <span>Data e Hora de Início</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <input asp-for="DataInicio"
                                   class="form-control subevento-input"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   value="@(Model != null && Model.DataInicio != default ? Model.DataInicio.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="DataInicio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DataFim" class="subevento-label">
                                <i class="bi bi-calendar-x"></i>
                                <span>Data e Hora de Término</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <input asp-for="DataFim"
                                   class="form-control subevento-input"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   value="@(Model != null && Model.DataFim != default ? Model.DataFim.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="DataFim" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DataInicioInscricao" class="subevento-label">
                                <i class="bi bi-door-open"></i>
                                <span>Início das Inscrições</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <input asp-for="DataInicioInscricao"
                                   class="form-control subevento-input"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   value="@(Model != null && Model.DataInicioInscricao != default ? Model.DataInicioInscricao.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="DataInicioInscricao" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DataFimInscricao" class="subevento-label">
                                <i class="bi bi-door-closed"></i>
                                <span>Fim das Inscrições</span>
                                <span class="subevento-required">*</span>
                            </label>
                            <input asp-for="DataFimInscricao"
                                   class="form-control subevento-input"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   value="@(Model != null && Model.DataFimInscricao != default ? Model.DataFimInscricao.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="DataFimInscricao" class="text-danger small"></span>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-4 subevento-side-panel">
                <section class="subevento-card">
                    <div class="subevento-card-header">
                        <div class="subevento-card-icon">
                            <i class="bi bi-gear"></i>
                        </div>
                        <div>
                            <h2 class="subevento-card-title">Capacidade e Certificação</h2>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="subevento-label">
                            <i class="bi bi-toggle-on"></i>
                            <span>Status</span>
                            <span class="subevento-required">*</span>
                        </label>
                        <select asp-for="Status" class="form-select subevento-select">
                            <option value="A">Ativo</option>
                            <option value="C">Cadastro</option>
                            <option value="F">Finalizado</option>
                            <option value="I">Inativo</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="VagasOfertadas" class="subevento-label">
                                <i class="bi bi-people"></i>
                                <span>Vagas Ofertadas</span>
                            </label>
                            <input asp-for="VagasOfertadas" class="form-control subevento-input" type="number" step="1" min="0" />
                            <span asp-validation-for="VagasOfertadas" class="text-danger small"></span>
                        </div>

                        <div class="col-6">
                            <label asp-for="CargaHoraria" class="subevento-label">
                                <i class="bi bi-clock"></i>
                                <span>Carga Horária</span>
                            </label>
                            <div class="input-group subevento-input-group">
                                <input asp-for="CargaHoraria" class="form-control" type="number" step="1" min="0" />
                                <span class="input-group-text">h</span>
                            </div>
                            <span asp-validation-for="CargaHoraria" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="subevento-switch-box mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="InscricaoGratuita_Checkbox"
                                   @(Model.InscricaoGratuita == 1 ? "checked" : "") />
                            <label class="form-check-label" for="InscricaoGratuita_Checkbox">Inscrição Gratuita</label>
                            <input type="hidden" id="InscricaoGratuita" name="InscricaoGratuita" value="@(Model.InscricaoGratuita == 1 ? 1 : 0)" />
                        </div>
                        <span asp-validation-for="InscricaoGratuita" class="text-danger small"></span>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="PossuiCertificado_Checkbox"
                                   @(Model.PossuiCertificado == 1 ? "checked" : "") />
                            <label class="form-check-label" for="PossuiCertificado_Checkbox">Possui Certificado Próprio</label>
                            <input type="hidden" id="PossuiCertificado" name="PossuiCertificado" value="@(Model.PossuiCertificado == 1 ? 1 : 0)" />
                        </div>
                        <span asp-validation-for="PossuiCertificado" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-6" id="FrequenciaMinimaCertificado">
                            <label for="FrequenciaMinimaCertificado_Tela" class="subevento-label">
                                <span>Freq. Mínima (%)</span>
                            </label>
                            <div class="input-group subevento-input-group" id="frequenciaInputGroup">
                                <input type="text"
                                       id="FrequenciaMinimaCertificado_Tela"
                                       class="form-control"
                                       value="@Model.FrequenciaMinimaCertificado.ToString("F2", culturaPtBr)"
                                       placeholder="0,00"
                                       inputmode="decimal" />
                                <span class="input-group-text">%</span>
                                <input type="hidden" asp-for="FrequenciaMinimaCertificado" id="FrequenciaMinimaCertificado_Real" />
                            </div>
                            <span asp-validation-for="FrequenciaMinimaCertificado" class="text-danger small d-block"></span>
                        </div>

                        <div class="col-6" id="valorInscricaoGroup">
                            <label for="ValorInscricao_Tela" class="subevento-label">
                                <span>Valor (R$)</span>
                            </label>
                            <div class="input-group subevento-input-group" id="valorInscricaoInputGroup">
                                <span class="input-group-text">R$</span>
                                <input type="text"
                                       id="ValorInscricao_Tela"
                                       class="form-control"
                                       value="@Model.ValorInscricao.ToString("F2", culturaPtBr)"
                                       placeholder="0,00"
                                       inputmode="decimal" />
                                <input type="hidden" asp-for="ValorInscricao" id="ValorInscricao_Real" />
                            </div>
                            <span asp-validation-for="ValorInscricao" id="valorInscricaoMsg" class="text-danger small d-block"></span>
                        </div>
                    </div>
                </section>

                <div class="subevento-actions-bar">
                    <a asp-controller="Evento"
                       asp-action="GerenciarEvento"
                       asp-route-idEvento="@eventoId"
                       class="btn btn-outline-danger bg-white rounded-3 px-4 py-2 fw-semibold text-decoration-none">
                        Cancelar
                    </a>
                    <button type="submit"
                            class="btn btn-blue-normal color-white rounded-3 px-4 py-2 fw-semibold shadow-sm flex-fill d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-save"></i>
                        <span>@(isEdicao ? "Salvar Alterações" : "Salvar Subevento")</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/subevento.js" asp-append-version="true"></script>
}
