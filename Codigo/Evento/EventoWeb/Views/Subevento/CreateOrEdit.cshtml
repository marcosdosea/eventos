@model EventoWeb.Models.SubeventoModel

@{
    ViewData["Title"] = "CreateOrEdit";
    Layout = "_LayoutGestor";
}

<h1 class="blue-normal">Cadastro de SubEventos</h1>
<hr />
<div class="row">
    <div>
        <form asp-action="CreateOrEdit" method="post">
            @if (Model.Id != 0)
            {
                <input type="hidden" name="id" value="@Model.Id" />
            }
            <div class="row">
                <div class="col-lg-3">
                    <div class="form-group">
                        <label for="IdEvento" class="control-label">Evento</label>
                        <select id="IdEvento" name="IdEvento" class="form-control" readonly>
                            @if (Model.Evento == null || Model.Evento.Id == 0)
                            {
                                <option value="0">Não Informado</option>
                            }
                            else
                            {
                                <option value="@Model.Evento.Id" selected>@Model.Evento.Nome</option>
                            }
                        </select>
                        @Html.HiddenFor(model => model.Evento.Id)
                        @Html.HiddenFor(model => model.IdEvento)
                    </div>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-8 col-sm-8 col-md-8 col-lg-8">
                    <div class="form-group">
                        <label asp-for="Nome" class="control-label">Nome</label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="IdTipoEvento" class="control-label">Tipo</label>
                        <select asp-for="IdTipoEvento" class="form-control" asp-items="Model.TiposEventos">
                            <option value="">Escolha Tipo</option>
                        </select>
                        <span asp-validation-for="IdTipoEvento" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Descricao" class="control-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>
            </div>       
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="DataInicio" class="control-label">Data Início</label>
                            <input asp-for="DataInicio" class="form-control" style="width:13rem; type="date" />
                            <span asp-validation-for="DataInicio" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="DataFim" class="control-label">Data Fim</label>
                            <input asp-for="DataFim" class="form-control" style="width:13rem; type="date" />
                            <span asp-validation-for="DataFim" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3 mt-4">
                        <div class="form-group mb-2">
                            <div class="d-flex align-items-center">
                                <div class="form-check">
                                    <!-- Checkbox que marca se a inscrição será gratuita (valor 1) -->
                                    <input class="form-check-input" type="checkbox" id="InscricaoGratuita_Checkbox"
                                    @(Model.InscricaoGratuita == 1 ? "checked" : "")>
                                    <label class="form-check-label" for="InscricaoGratuita_Checkbox">Gratuito</label>
                                    <!-- Campo oculto para enviar 1 ou 0 correspondente à propriedade do Model -->
                                    <input type="hidden" id="InscricaoGratuita" name="InscricaoGratuita" value="@(Model.InscricaoGratuita == 1 ? 1 : 0)">
                                </div>
                            </div>
                            <span asp-validation-for="InscricaoGratuita" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3 mt-4">
                        <div class="form-group mb-3">
                            <div class="d-flex align-items-center">
                                <div class="form-check">
                                    <!-- Checkbox que marca se o subevento terá certificado (valor 1) -->
                                    <input class="form-check-input" type="checkbox" id="PossuiCertificado_Checkbox"
                                    @(Model.PossuiCertificado == 1 ? "checked" : "")>
                                    <label class="form-check-label" for="PossuiCertificado_Checkbox">Possui certificado</label>
                                    <!-- Campo oculto para enviar 1 ou 0 correspondente à propriedade do Model -->
                                    <input type="hidden" id="PossuiCertificado" name="PossuiCertificado" value="@(Model.PossuiCertificado == 1 ? 1 : 0)">
                                </div>
                            </div>
                            <span asp-validation-for="PossuiCertificado" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            <br />        
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Status" class="control-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="C">Cadastro</option>
                                <option value="A">Ativo</option>
                                <option value="F">Finalizado</option>
                                <option value="I">Inativo</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="DataInicioInscricao" class="control-label">Início das inscrições</label>
                            <input asp-for="DataInicioInscricao" class="form-control" style="width:13rem; type="date" />
                            <span asp-validation-for="DataInicioInscricao" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="DataFimInscricao" class="control-label">Fim das inscrições</label>
                            <input asp-for="DataFimInscricao" class="form-control" style="width:13rem; type="date" />
                            <span asp-validation-for="DataFimInscricao" class="text-danger"></span>
                        </div>
                    </div>
                </div>      
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group" id="FrequenciaMinimaCertificado">
                        <label asp-for="FrequenciaMinimaCertificado" class="control-label">Frequência mínima de emissão de certificado</label>
                        <div class="input-group" style="width:10rem;">
                            <input type="text" id="FrequenciaMinimaCertificado_Tela" class="form-control" style="border-right-style:none;" value="@Model.FrequenciaMinimaCertificado.ToString("F2", new System.Globalization.CultureInfo("pt-BR"))" placeholder="0,00" />
                            <input type="hidden" asp-for="FrequenciaMinimaCertificado" id="FrequenciaMinimaCertificado_Real" />
                            <span class="input-group-text" style="background-color:white;">%</span>
                        </div>
                        <span asp-validation-for="FrequenciaMinimaCertificado" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group" style="width:13rem;">
                        <label asp-for="VagasOfertadas" class="control-label">Vagas ofertadas</label>
                        <input asp-for="VagasOfertadas" class="form-control" type="number" step="1" min="0" />
                        <span asp-validation-for="VagasOfertadas" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group" style="width:13rem;">
                        <label asp-for="CargaHoraria" class="control-label">Carga horária</label>
                        <input asp-for="CargaHoraria" class="form-control" type="number" step="1" min="0" />
                        <span asp-validation-for="CargaHoraria" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group" id="valorInscricaoGroup">
                        <label asp-for="ValorInscricao" class="control-label">Menor valor de inscrição (R$)</label>
                        <div class="input-group" style="width:10rem;">
                            <span class="input-group-text" style="background-color:white;">R$</span>
                            <input type="text" id="ValorInscricao_Tela" class="form-control" style="border-left-style:none;" value="@Model.ValorInscricao.ToString("F2", new System.Globalization.CultureInfo("pt-BR"))" placeholder="0,00" />
                            <input type="hidden" asp-for="ValorInscricao" id="ValorInscricao_Real" />
                        </div>
                        <span asp-validation-for="ValorInscricao" id="valorInscricaoMsg" class="text-danger d-block"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <!-- Espaço em branco -->
            </div>
            <div class="d-flex justify-content-end">
                <div class="d-flex flex-row">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="submit" value="Salvar" class="btn btn-blue-normal color-white" />
                    </div>
                    <div class="form-group">
                        <a asp-controller="Evento" asp-action="GerenciarEvento" asp-route-idEvento="@(Model.IdEvento != 0 ? Model.IdEvento : (Model.Evento != null ? Model.Evento.Id : 0))" class="btn btn-outline-danger">Voltar</a>
                    </div>
                </div>
            </div>
            <br />
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function gerenciarCampoDecimal(idTela, idReal) {
            const campoTela = document.getElementById(idTela);
            const campoReal = document.getElementById(idReal);
            if (!campoTela || !campoReal) return;

            if (!campoReal.value || campoReal.value === '') {
                campoReal.value = campoTela.value;
            }

            campoTela.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 0) {
                    value = (parseFloat(value) / 100).toFixed(2).replace('.', ',');
                } else {
                    value = '0,00';
                }
                e.target.value = value;
                campoReal.value = value;

                if (idTela === 'ValorInscricao_Tela') {
                    validarGratuitoValor();
                }
            });
        }

        gerenciarCampoDecimal('FrequenciaMinimaCertificado_Tela', 'FrequenciaMinimaCertificado_Real');
        gerenciarCampoDecimal('ValorInscricao_Tela', 'ValorInscricao_Real');

        const checkboxGratuito = document.getElementById('InscricaoGratuita_Checkbox');
        const hiddenGratuito = document.getElementById('InscricaoGratuita');
        const campoValorTela = document.getElementById('ValorInscricao_Tela');
        const campoValorReal = document.getElementById('ValorInscricao_Real');
        const msgValor = document.getElementById('valorInscricaoMsg');

        function validarGratuitoValor() {
            if (!checkboxGratuito || !campoValorReal) return true;
            const isGratuito = checkboxGratuito.checked;
            const valorTexto = campoValorReal.value || '0,00';
            const valorNumerico = parseFloat(valorTexto.replace('.', '').replace(',', '.'));

            if (isGratuito && valorNumerico > 0) {
                if (msgValor) {
                    msgValor.innerText = 'Para subeventos gratuitos, o valor de inscrição deve ser 0,00.';
                }
                return false;
            } else {
                if (msgValor) {
                    msgValor.innerText = '';
                }
                return true;
            }
        }

        if (checkboxGratuito) {
            checkboxGratuito.addEventListener('change', function () {
                if (hiddenGratuito) {
                    hiddenGratuito.value = this.checked ? '1' : '0';
                }
                if (this.checked) {
                    if (campoValorTela) campoValorTela.value = '0,00';
                    if (campoValorReal) campoValorReal.value = '0,00';
                    if (msgValor) msgValor.innerText = '';
                } else {
                    validarGratuitoValor();
                }
            });
        }

        const checkboxCertificado = document.getElementById('PossuiCertificado_Checkbox');
        const hiddenCertificado = document.getElementById('PossuiCertificado');
        if (checkboxCertificado) {
            checkboxCertificado.addEventListener('change', function () {
                if (hiddenCertificado) {
                    hiddenCertificado.value = this.checked ? '1' : '0';
                }
            });
        }

        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function (e) {
                if (!validarGratuitoValor()) {
                    e.preventDefault();
                    if (campoValorTela) {
                        campoValorTela.focus();
                    }
                    return false;
                }
            });
        }

        validarGratuitoValor();
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
