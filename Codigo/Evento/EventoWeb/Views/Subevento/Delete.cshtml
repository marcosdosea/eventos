@model EventoWeb.Models.SubeventoModel

@{
    ViewData["Title"] = "Excluir Subevento";
    var culturaPtBr = new System.Globalization.CultureInfo("pt-BR");

    var (statusDescricao, statusClasse) = Model.Status switch
    {
        "A" => ("Ativo", "subevento-pill-ativo"),
        "C" => ("Cadastro", "subevento-pill-cadastro"),
        "F" => ("Finalizado", "subevento-pill-finalizado"),
        "I" => ("Inativo", "subevento-pill-inativo"),
        _ => ("Desconhecido", "subevento-pill-finalizado")
    };

    var inscricaoGratuita = Model.InscricaoGratuita == 1;
    var possuiCertificado = Model.PossuiCertificado == 1;
}

<link rel="stylesheet" href="~/css/subevento.css" asp-append-version="true" />

<div class="subevento-page-container">
    <nav class="subevento-breadcrumb justify-content-center mb-3" aria-label="Navegação estrutural">
        <a asp-controller="Evento" asp-action="GerenciarEvento" asp-route-idEvento="@Model.IdEvento">
            <i class="bi bi-house-door me-1"></i>Gerenciar Evento
        </a>
        <i class="bi bi-chevron-right small"></i>
        <a asp-controller="Subevento" asp-action="Index" asp-route-idEvento="@Model.IdEvento">Subeventos</a>
        <i class="bi bi-chevron-right small"></i>
        <span class="subevento-breadcrumb-active">Excluir Subevento</span>
    </nav>

    <div class="subevento-delete-card">
        <div class="d-flex align-items-center gap-3 mb-2">
            <div class="subevento-delete-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <h1 class="subevento-title fs-3 mb-1">Excluir Subevento</h1>
                <p class="text-muted small mb-0">
                    Esta ação não poderá ser desfeita. Confirme os dados abaixo antes de remover este subevento.
                </p>
            </div>
        </div>

        <div class="subevento-summary-box">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                <div>
                    <span class="subevento-summary-label">Subevento</span>
                    <div class="fw-bold text-dark fs-5">@Model.Nome</div>
                    <div class="text-muted small mt-1">
                        <i class="bi bi-calendar-event text-primary me-1"></i>
                        <span>@(string.IsNullOrWhiteSpace(Model.NomeEvento) ? "Evento vinculado" : Model.NomeEvento)</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.NomeTipoEvento))
                    {
                        <span class="subevento-type-badge">@Model.NomeTipoEvento</span>
                    }
                    <span class="subevento-pill @statusClasse">
                        <span class="dot">●</span>
                        <span>@statusDescricao</span>
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Descricao))
            {
                <div class="mb-3">
                    <span class="subevento-summary-label">Descrição / Ementa</span>
                    <div class="text-secondary small">@Model.Descricao</div>
                </div>
            }

            <div class="subevento-summary-divider"></div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="subevento-summary-label">Início do Subevento</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.DataInicio.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="col-sm-6">
                    <span class="subevento-summary-label">Término do Subevento</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.DataFim.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="col-sm-6">
                    <span class="subevento-summary-label">Início das Inscrições</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.DataInicioInscricao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="col-sm-6">
                    <span class="subevento-summary-label">Fim das Inscrições</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.DataFimInscricao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="col-sm-4">
                    <span class="subevento-summary-label">Inscrição Gratuita</span>
                    <span class="subevento-summary-value">@(inscricaoGratuita ? "Sim" : "Não")</span>
                </div>
                <div class="col-sm-4">
                    <span class="subevento-summary-label">Valor de Inscrição</span>
                    <span class="subevento-summary-value subevento-summary-mono">R$ @Model.ValorInscricao.ToString("N2", culturaPtBr)</span>
                </div>
                <div class="col-sm-4">
                    <span class="subevento-summary-label">Carga Horária</span>
                    <span class="subevento-summary-value">@Model.CargaHoraria h</span>
                </div>

                <div class="col-sm-4">
                    <span class="subevento-summary-label">Possui Certificado</span>
                    <span class="subevento-summary-value">@(possuiCertificado ? "Sim" : "Não")</span>
                </div>
                <div class="col-sm-4">
                    <span class="subevento-summary-label">Frequência Mínima</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.FrequenciaMinimaCertificado.ToString("N2", culturaPtBr)%</span>
                </div>
                <div class="col-sm-4">
                    <span class="subevento-summary-label">Vagas (Ofertadas / Reservadas / Disponíveis)</span>
                    <span class="subevento-summary-value subevento-summary-mono">@Model.VagasOfertadas / @Model.VagasReservadas / @Model.VagasDisponiveis</span>
                </div>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IdEvento" />

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2">
                <a asp-controller="Evento"
                   asp-action="GerenciarEvento"
                   asp-route-idEvento="@Model.IdEvento"
                   class="btn btn-outline-blue-normal bg-white px-4 py-2 rounded-3 fw-semibold text-decoration-none">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-trash"></i>
                    <span>Confirmar Exclusão</span>
                </button>
            </div>
        </form>
    </div>
</div>
