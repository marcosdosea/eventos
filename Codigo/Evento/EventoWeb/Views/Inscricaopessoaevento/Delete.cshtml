@model Core.DTO.InscricaopessoaeventoDTO

@{
    ViewData["Title"] = "Remover Inscrição de Participante";
}

<div class="container-fluid no-padding">
    <div class="row">
        <h1 class="blue-normal">Remover Inscrição de Participante</h1>
        <div>
            <h3>Tem certeza que deseja remover esta inscrição?</h3>
            <dl class="row">
                <dt class="col-sm-2">Participante</dt>
                <dd class="col-sm-10">@ViewBag.NomePessoa</dd>

                <dt class="col-sm-2">Evento</dt>
                <dd class="col-sm-10">@ViewBag.NomeEvento</dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.DataInscricao)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.DataInscricao)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ValorTotal)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ValorTotal)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Status)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Status)
                </dd>
            </dl>
            <div class="text-danger fw-bold small mb-3">
                Essa operação não pode ser desfeita.
            </div>
        </div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end">
                <div class="d-flex flex-row">
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="submit" value="Remover" class="btn btn-danger" />
                    </div>
                    <div class="form-group">
                        <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>