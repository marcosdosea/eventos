@model IEnumerable<EventoWeb.Models.EventoModel>

@{
	ViewData["Title"] = "Index";
}

<link href="~/lib/datatable/css/datatables.min.css" rel="stylesheet" />

<div class="container">
	<h1 class="blue-normal">Seja Bem-vindo</h1>
	<h3>Confira os eventos do sistema!</h3>
	<div class="btn-container">
		<button type="button" class="btn btn-lg btn-blue-normal mb-2" onclick="location.href='@Url.Action("Create")'">
			Novo evento
		</button>
	</div>
	<br />
	<table id="tableEvento" class="table table-striped table-bordered dt-responsive nowrap">
		<thead>
			<tr class="blue-normal blue-normal-bg-table">
				<th>@Html.DisplayNameFor(model => model.DataInicio)</th>
				<th>@Html.DisplayNameFor(model => model.Nome)</th>
				<th>@Html.DisplayNameFor(model => model.Status)</th>
				<th>Tipo do Evento</th>
				<th>Ações</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@Html.DisplayFor(modelItem => item.DataInicio)</td>
					<td>@Html.DisplayFor(modelItem => item.Nome)</td>
					<td>
						@{
							string statusDescricao = "Desconhecido";
							switch (item.Status)
							{
								case "A":
									statusDescricao = "Ativo";
									break;
								case "C":
									statusDescricao = "Cadastro";
									break;
								case "F":
									statusDescricao = "Finalizado";
									break;
							}
						}
						@statusDescricao
					</td>
					<td>@Html.DisplayFor(modelItem => item.NomeTipoEvento)</td>
					<td>
						@Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @style = "text-decoration:none;" })
						&nbsp;&nbsp;
						<a href="javascript:void(0);"
						   style="text-decoration:none;"
						   class="danger-normal link-excluir-evento"
						   data-evento-id="@item.Id"
						   data-evento-nome="@item.Nome">Excluir</a>
						&nbsp;&nbsp;
						@Html.ActionLink("Gestores", "CreateGestor", new { idEvento = item.Id}, new { @style = "text-decoration:none;" })
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="modal fade text-wrap" id="modalExcluirEvento" tabindex="-1" role="dialog" aria-labelledby="modalExcluirEventoLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content border-0 shadow">
			<div class="modal-header bg-primary text-white position-relative">
				<h5 class="modal-title w-100 text-center fw-bold" id="modalExcluirEventoLabel">Confirmar exclusão</h5>
				<button type="button" class="btn-close btn-close-white position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center p-4 text-break">
				<h5 class="fs-5 fw-normal text-break mb-3">
					Tem certeza que deseja excluir "<strong id="nomeEventoExcluir"></strong>"?
				</h5>
				<div class="text-danger fw-bold small">
					Essa operação não pode ser desfeita.
				</div>
			</div>
			<form id="formExcluirEvento" asp-action="Delete" asp-controller="Evento" method="post" class="modal-footer justify-content-center border-top-0 pt-0 pb-4">
				<input type="hidden" name="id" id="idEventoExcluir" value="0" />
				<button type="button" class="btn btn-primary px-4 me-2" data-bs-dismiss="modal">Não</button>
				<button type="submit" class="btn btn-danger px-4" id="btnConfirmarExclusaoEvento">Sim</button>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/lib/datatable/js/datatables.min.js"></script>
	<script>
		$(document).ready(function () {
			$('#tableEvento').DataTable({
				columnDefs: [
					{ orderable: true, targets: [0, 1] },
					{ orderable: false, targets: [2, 3, 4] }
				],
				searching: true,
				ordering: true,
				paging: true,
				language: {
					url: '@Url.Content("~/lib/datatable/js/pt-BR.json")'
				}
			});

			$(document).on('click', '.link-excluir-evento', function () {
				var id = $(this).data('evento-id');
				var nome = $(this).data('evento-nome');
				$('#nomeEventoExcluir').text(nome);
				$('#idEventoExcluir').val(id);
				$('#formExcluirEvento').attr('action', '@Url.Action("Delete", "Evento")/' + id);
				var modal = new bootstrap.Modal(document.getElementById('modalExcluirEvento'));
				modal.show();
			});
		});
	</script>
}