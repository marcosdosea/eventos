@model IEnumerable<EventoWeb.Models.EventoModel>

@{
    ViewData["Title"] = "Gerenciamento de Eventos";
    var listaEventos = Model?.ToList() ?? new List<EventoWeb.Models.EventoModel>();
    var totalEventos = listaEventos.Count;
    var exibicaoInicial = totalEventos == 0 ? "0" : $"1-{Math.Min(10, totalEventos)}";
}

<link href="~/lib/datatable/css/datatables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/evento-admin.css" asp-append-version="true" />

<div class="evento-page-container">
    <nav class="evento-breadcrumb" aria-label="Navegação estrutural">
        <span class="d-inline-flex align-items-center gap-1">
            <i class="bi bi-house-door"></i>
            <span>Painel Administrativo</span>
        </span>
        <i class="bi bi-chevron-right small opacity-75"></i>
        <span class="evento-breadcrumb-active">Eventos</span>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="evento-title">@ViewData["Title"]</h1>
            <p class="evento-subtitle">Cadastre, acompanhe e gerencie os eventos e seus gestores responsáveis</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="evento-count-badge">
                <i class="bi bi-calendar2-week"></i>
                <span>@totalEventos @(totalEventos == 1 ? "evento" : "eventos")</span>
            </span>
            <a asp-action="Create" class="btn btn-blue-normal color-white rounded-3 px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-plus-lg"></i>
                <span>Novo Evento</span>
            </a>
        </div>
    </div>

    @if (listaEventos.Any())
    {
        <section class="evento-table-card" aria-labelledby="tituloTabelaEventos">
            <div class="evento-table-toolbar">
                <div class="d-flex align-items-center gap-2">
                    <div class="evento-card-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <h2 id="tituloTabelaEventos" class="evento-card-title">Eventos Cadastrados</h2>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1 justify-content-md-end">
                    <select id="filtroStatusEvento" class="form-select evento-filter-select" aria-label="Filtrar por status">
                        <option value="">Todos os Status</option>
                        <option value="C">Cadastro</option>
                        <option value="A">Ativo</option>
                        <option value="F">Finalizado</option>
                        <option value="I">Inativo</option>
                    </select>

                    <div class="evento-search-box">
                        <i class="bi bi-search text-muted me-2"></i>
                        <input type="text" id="filtroEventos" class="evento-search-input" placeholder="Buscar por nome, tipo ou status..." aria-label="Buscar eventos" />
                        <button type="button" id="btnLimparFiltroEventos" class="evento-clear-btn d-none" title="Limpar busca" aria-label="Limpar busca">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="tableEvento" class="evento-table align-middle">
                    <thead>
                        <tr>
                            <th style="min-width: 145px;">Data de Início</th>
                            <th style="min-width: 240px;">Nome do Evento</th>
                            <th style="width: 140px;">Status</th>
                            <th style="min-width: 165px;">Tipo do Evento</th>
                            <th class="text-end" style="min-width: 240px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listaEventos)
                        {
                            var (statusDescricao, statusClasse) = item.Status switch
                            {
                                "A" => ("Ativo", "evento-pill-ativo"),
                                "C" => ("Cadastro", "evento-pill-cadastro"),
                                "F" => ("Finalizado", "evento-pill-finalizado"),
                                "I" => ("Inativo", "evento-pill-inativo"),
                                _ => ("Desconhecido", "evento-pill-finalizado")
                            };
                            var tipoEventoTexto = string.IsNullOrWhiteSpace(item.NomeTipoEvento) ? "Não informado" : item.NomeTipoEvento;
                            var buscaTexto = $"{item.Id} {item.Nome} {tipoEventoTexto} {statusDescricao}".ToLowerInvariant();

                            <tr class="linha-evento" data-status="@item.Status" data-busca="@buscaTexto">
                                <td data-order="@(item.DataInicio?.ToString("yyyy-MM-ddTHH:mm") ?? "")">
                                    @if (item.DataInicio.HasValue)
                                    {
                                        <span class="fw-semibold text-dark">@item.DataInicio.Value.ToString("dd/MM/yyyy")</span>
                                        <span class="text-muted small ms-1">@item.DataInicio.Value.ToString("HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Não definida</span>
                                    }
                                </td>
                                <td data-order="@item.Nome">
                                    <div class="evento-nome-col">@item.Nome</div>
                                    <div class="evento-mono-id">#@item.Id</div>
                                </td>
                                <td data-order="@statusDescricao">
                                    <span class="evento-pill @statusClasse">
                                        <span class="dot">●</span>
                                        <span>@statusDescricao</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="evento-tipo-badge">@tipoEventoTexto</span>
                                </td>
                                <td class="text-end">
                                    <div class="evento-actions-group">
                                        <a asp-action="CreateGestor" asp-route-idEvento="@item.Id" class="evento-action-gestores" title="Gerenciar gestores do evento">
                                            <i class="bi bi-people"></i>
                                            <span>Gestores</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="evento-action-edit" title="Editar evento">
                                            <i class="bi bi-pencil"></i>
                                            <span>Editar</span>
                                        </a>
                                        <button type="button"
                                                class="evento-action-delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalExcluirEvento"
                                                data-evento-id="@item.Id"
                                                data-evento-nome="@item.Nome"
                                                title="Excluir evento"
                                                aria-label="Excluir evento @item.Nome">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            <span>Excluir</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="evento-table-footer">
                <div class="text-muted small">
                    Exibindo <strong id="lblEventosInicioFim">@exibicaoInicial</strong> de <strong id="lblEventosTotal">@totalEventos</strong> @(totalEventos == 1 ? "evento" : "eventos")
                </div>

                <div class="pagination-custom d-flex align-items-center gap-1" id="paginacaoEventosNav"></div>
            </div>
        </section>

        <div class="modal fade" id="modalExcluirEvento" tabindex="-1" aria-labelledby="tituloExcluirEventoModal" aria-describedby="descricaoExcluirEventoModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="Delete" asp-controller="Evento" method="post" class="modal-content rounded-4 shadow border-0">
                    <input type="hidden" name="id" id="excluirEventoId" />
                    <div class="modal-header border-0 pb-0">
                        <h2 class="modal-title h5 fw-bold d-flex align-items-center gap-2" id="tituloExcluirEventoModal">
                            <span class="evento-delete-modal-icon" aria-hidden="true">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                            <span>Confirmar exclusão</span>
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body" id="descricaoExcluirEventoModal">
                        <p class="mb-2">
                            Tem certeza que deseja excluir o evento <strong id="excluirEventoNome"></strong>?
                        </p>
                        <p class="text-danger fw-semibold small mb-0">
                            Essa operação não pode ser desfeita.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn evento-back-btn rounded-3" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-3 fw-semibold d-inline-flex align-items-center gap-1" id="btnConfirmarExclusaoEvento">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            <span>Excluir evento</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="evento-empty-box">
            <div class="evento-empty-icon">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">Nenhum evento cadastrado</h2>
            <p class="text-muted small mb-3">Ainda não existem eventos registrados no sistema. Comece criando o primeiro evento.</p>
            <a asp-action="Create" class="btn btn-blue-normal color-white rounded-3 px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-plus-lg"></i>
                <span>Cadastrar Evento</span>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/evento-admin.js" asp-append-version="true"></script>
}
