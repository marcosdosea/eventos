@using Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model GerenciarEventoModel

@{
    ViewData["Title"] = "Gerenciar Evento";
    ViewData["ExibirMenuSanduiche"] = true;
}
<link rel="stylesheet" type="text/css" href="~/css/_gerenciarevento.css">

@if (TempData["Message"] != null)
{
    <div class="alert alert-danger" role="alert" id="alerterror">
        @TempData["Message"]
    </div>
    TempData.Remove("Message");
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert" id="alerterror2">
        @TempData["ErrorMessage"]
    </div>
    TempData.Remove("ErrorMessage");
}
<script>
    setTimeout(function() {
        $("#alerterror").fadeOut("slow");
        $("#alerterror2").fadeOut("slow");
    }, 3000);</script>
<div class="mt-4">
    <div class="w-100 mb-4">
        <h1 class="blue-normal">Gerenciar evento</h1>
        <div class="d-flex flex-wrap gap-4 align-items-center text-muted mt-2">
            <div><strong class="text-dark">Nome:</strong> @Model.Evento.Nome</div>
            <div><strong class="text-dark">Data:</strong> @Model.Evento.DataInicio?.ToString("dd/MM/yyyy")</div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        @{
            var isGestorOuAdmin = User.IsInRole("GESTOR") || User.IsInRole("ADMINISTRADOR");

            var cardsList = new List<dynamic>();

            if (!isGestorOuAdmin)
            {
                cardsList.Add(new { Nome = "Frequência", Action = "Frequencia", Controller = "Participacaopessoaevento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Inscrições", Action = "CreateParticipante", Controller = "Evento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
            }
            else
            {
                cardsList.Add(new { Nome = "Frequência", Action = "Frequencia", Controller = "Participacaopessoaevento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Inscrições", Action = "CreateParticipante", Controller = "Evento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Colaboradores", Action = "CreateColaborador", Controller = "Evento", Icon = "Colaboradores.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Evento", Action = "GestorEditarEvento", Controller = "Evento", Icon = "Evento.png", Parametros = (object)new { id = Model.Evento.Id } });
            }

            cardsList.Add(new { Nome = "Usuário", Action = "CreateUsuario", Controller = "Evento", Icon = "Participantes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
        }

        @foreach (var item in cardsList)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card card-gerenciar h-100 p-3 d-flex flex-column align-items-center justify-content-center text-center">
                    <img src="~/ícones/@item.Icon" alt="@item.Nome">
                    <div class="mt-3">
                        @Html.ActionLink((string)item.Nome, (string)item.Action, (string)item.Controller,
                        (object)item.Parametros, new { @class = "stretched-link text-decoration-none card-link" })
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <h2 class="blue-normal mb-0">SubEventos</h2>
        @if (isGestorOuAdmin)
        {
            <button type="button" class="btn btn-blue-normal btn-lg" onclick="window.location.href='@Url.Action("CreateOrEdit", "Subevento", new { idEvento = Model.Evento.Id })'">
                Novo Subevento
            </button>
        }
    </div>

    <div class="table-responsive mt-2 mb-4">
        <table class="table table-striped table-hover align-middle">
            <thead class="blue-normal blue-normal-bg-table">
                <tr>
                    <th>Tipo</th>
                    <th>Nome</th>
                    <th>Vagas Ofertadas</th>
                    <th>Vagas Disponíveis</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subevento in Model.Subeventos)
                {
                    <tr>
                        <td>@subevento.NomeTipoEvento</td>
                        <td>@subevento.Nome</td>
                        <td>@subevento.VagasOfertadas</td>
                        <td>@subevento.VagasDisponiveis</td>
                        <td>
                            <div class="d-flex gap-3 align-items-center">
                                <a asp-controller="ParticipacaoPessoaEvento"
                                   asp-action="Frequencia"
                                   asp-route-idEvento="@Model.Evento.Id"
                                   asp-route-idSubEvento="@subevento.Id"
                                   class="btn btn-sm btn-blue-normal text-white"
                                   title="Frequência do Subevento">
                                    <i class="bi bi-calendar-check me-1"></i> Frequência
                                </a>

                                @if (isGestorOuAdmin)
                                {
                                    @Html.ActionLink("Editar", "CreateOrEdit", "Subevento",
                                        new { idEvento = Model.Evento.Id, idSubevento = subevento.Id },
                                        new { @style = "text-decoration:none;" })

                                    @using (Html.BeginForm("Delete", "Subevento", FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@subevento.Id" />
                                        <a href="#" onclick="if (confirm('Tem certeza que deseja excluir?')) { this.closest('form').submit(); } return false;"
                                           style="color: #dc3545; text-decoration: none; cursor: pointer;">Excluir</a>
                                    }

                                    @Html.ActionLink("Tipo Inscrição", "CreateTipoInscricaoSubevento", "TipoInscricao",
                                        new { idEvento = Model.Evento.Id, idSubevento = subevento.Id },
                                        new { @style = "text-decoration:none;" })
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end mt-2 mb-5 w-100">
        <a asp-controller="Evento" asp-action="GerenciarEventoListar" asp-route-idEvento="@ViewData["EventoId"]" class="btn btn-blue-normal btn-lg" style="text-decoration:none; color:white">
            Voltar
        </a>
    </div>
</div>