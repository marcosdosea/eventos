@using Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model GerenciarEventoModel

@{
    ViewData["Title"] = "Gerenciar Evento";
    ViewData["ExibirMenuSanduiche"] = true;
    ViewData["EventoId"] = Model.Evento.Id;

    var isAdmin = User.IsInRole("ADMINISTRADOR");
    var isGestor = User.IsInRole("GESTOR") && ViewData["GestorVinculado"] is true;
    var isGestorOuAdmin = isGestor || isAdmin;
    var podeOperar = ViewData["ParticipacaoEquipe"] is true &&
        (User.IsInRole("GESTOR") || User.IsInRole("COLABORADOR"));
    var subeventos = Model.Subeventos?.ToList() ?? new List<Core.DTO.SubeventoEventoDTO>();
    var qtdSubeventos = subeventos.Count;

    var (statusDescricao, statusClasse) = Model.Evento.Status switch
    {
        "A" => ("Ativo", "gestor-pill-ativo"),
        "C" => ("Cadastro", "gestor-pill-cadastro"),
        "F" => ("Finalizado", "gestor-pill-finalizado"),
        "I" => ("Inativo", "gestor-pill-inativo"),
        _ => ("Desconhecido", "gestor-pill-finalizado")
    };
}

<link rel="stylesheet" type="text/css" href="~/css/_gerenciarevento.css" asp-append-version="true">

<div class="gestor-page-container">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show gestor-alert mb-3" role="alert" id="alerterror">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
        TempData.Remove("Message");
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show gestor-alert mb-3" role="alert" id="alerterror2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
        TempData.Remove("ErrorMessage");
    }

    <nav class="gestor-breadcrumb" aria-label="Navegação estrutural">
        <a asp-controller="Evento" asp-action="GerenciarEventoListar" class="d-inline-flex align-items-center gap-1">
            <i class="bi bi-house-door"></i>
            <span>Meus Eventos</span>
        </a>
        <i class="bi bi-chevron-right small opacity-75"></i>
        <span class="gestor-breadcrumb-active">Gerenciar Evento</span>
    </nav>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="gestor-title">Gerenciar Evento</h1>
                <span class="gestor-pill @statusClasse">
                    <span class="dot">●</span>
                    <span>@statusDescricao</span>
                </span>
            </div>

            <div class="gestor-event-summary">
                <div class="gestor-event-summary-item">
                    <i class="bi bi-calendar-event"></i>
                    <strong class="text-dark">@Model.Evento.Nome</strong>
                </div>
                <div class="gestor-event-summary-item">
                    <i class="bi bi-clock"></i>
                    <span>@(Model.Evento.DataInicio.HasValue ? Model.Evento.DataInicio.Value.ToString("dd/MM/yyyy") : "Data não definida")</span>
                </div>
                <div class="gestor-event-summary-item">
                    <i class="bi bi-people"></i>
                    <span>@Model.Evento.VagasDisponiveis / @Model.Evento.VagasOfertadas vagas disponíveis</span>
                </div>
            </div>
        </div>

        <a asp-controller="Evento" asp-action="GerenciarEventoListar" asp-route-idEvento="@ViewData["EventoId"]" class="gestor-back-btn">
            <i class="bi bi-arrow-left"></i>
            <span>Voltar aos Eventos</span>
        </a>
    </div>

    <!-- Hub de Funcionalidades -->
    <div class="cards-gerenciar-wrapper mb-5">
        @{
            var cardsList = new List<dynamic>();
            if (podeOperar)
            {
                cardsList.Add(new { Nome = "Frequência", Action = "Frequencia", Controller = "Participacaopessoaevento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Inscrições", Action = "CreateParticipante", Controller = "Evento", Icon = "Inscricoes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Usuário", Action = "CreateUsuario", Controller = "Evento", Icon = "Participantes.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
            }
            if (isGestor)
            {
                cardsList.Add(new { Nome = "Colaboradores", Action = "CreateColaborador", Controller = "Evento", Icon = "Colaboradores.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
            }
            if (isAdmin || podeOperar)
            {
                cardsList.Add(new { Nome = "Emitir Crachá", Action = "EmitirCracha", Controller = "Modelocracha", Icon = "cracha.svg", Parametros = (object)new { idEvento = Model.Evento.Id } });
            }
            if (isGestorOuAdmin)
            {
                cardsList.Add(new { Nome = "Dashboard", Action = "Dashboard", Controller = "Evento", Icon = "Evento.png", Parametros = (object)new { idEvento = Model.Evento.Id } });
                cardsList.Add(new { Nome = "Evento", Action = isAdmin ? "Edit" : "GestorEditarEvento", Controller = "Evento", Icon = "Evento.png", Parametros = (object)new { id = Model.Evento.Id } });
            }
        }

        @foreach (var item in cardsList)
        {
            <div class="card-gerenciar">
                <div class="card-gerenciar-icon-wrap">
                    <img src="~/ícones/@item.Icon" alt="@item.Nome" />
                </div>
                <div class="mt-3">
                    @Html.ActionLink((string)item.Nome, (string)item.Action, (string)item.Controller,
                    (object)item.Parametros, new { @class = "stretched-link text-decoration-none card-link" })
                </div>
            </div>
        }
    </div>

    <!-- Tabela de Subeventos em Card -->
    <section class="gestor-table-card" aria-labelledby="tituloSubeventos">
        <div class="gestor-table-toolbar">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="gestor-card-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h2 id="tituloSubeventos" class="gestor-card-title">Subeventos do Evento</h2>
                <span class="gestor-count-badge">
                    @qtdSubeventos @(qtdSubeventos == 1 ? "subevento" : "subeventos")
                </span>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (qtdSubeventos > 0)
                {
                    <div class="gestor-search-box">
                        <i class="bi bi-search text-muted me-2"></i>
                        <input type="text" id="filtroSubeventos" class="gestor-search-input" placeholder="Filtrar subeventos..." aria-label="Filtrar subeventos" />
                    </div>
                }
                @if (isGestorOuAdmin)
                {
                    <a asp-controller="Subevento" asp-action="CreateOrEdit" asp-route-idEvento="@Model.Evento.Id"
                       class="btn btn-blue-normal color-white rounded-3 px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none">
                        <i class="bi bi-plus-lg"></i>
                        <span>Novo Subevento</span>
                    </a>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="gestor-table align-middle" id="tabelaSubeventos">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Nome</th>
                        <th class="text-center">Vagas Ofertadas</th>
                        <th class="text-center">Vagas Disponíveis</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (subeventos.Any())
                    {
                        foreach (var subevento in subeventos)
                        {
                            var temVaga = subevento.VagasDisponiveis > 0;
                            <tr class="linha-subevento" data-busca="@($"{subevento.Nome} {subevento.NomeTipoEvento}".ToLowerInvariant())">
                                <td>
                                    <span class="badge rounded-pill bg-light text-primary border border-primary-subtle px-3 py-1 fw-semibold">
                                        @subevento.NomeTipoEvento
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@subevento.Nome</td>
                                <td class="text-center font-monospace">@subevento.VagasOfertadas</td>
                                <td class="text-center">
                                    <span class="gestor-pill @(temVaga ? "gestor-pill-ativo" : "gestor-pill-inativo")">
                                        <span class="dot">●</span>
                                        <span>@subevento.VagasDisponiveis</span>
                                    </span>
                                </td>
                                <td class="text-end" style="white-space: nowrap;">
                                    <div class="d-inline-flex align-items-center gap-3">
                                        @if (podeOperar)
                                        {
                                            <a asp-controller="ParticipacaoPessoaEvento"
                                               asp-action="Frequencia"
                                               asp-route-idEvento="@Model.Evento.Id"
                                               asp-route-idSubEvento="@subevento.Id"
                                               class="btn btn-sm btn-blue-normal color-white rounded-3 px-3 fw-semibold"
                                               title="Frequência do Subevento">
                                                <i class="bi bi-calendar-check me-1"></i>Frequência
                                            </a>
                                        }

                                        @if (isGestorOuAdmin)
                                        {
                                            @Html.ActionLink("Editar", "CreateOrEdit", "Subevento",
                                                new { idEvento = Model.Evento.Id, idSubevento = subevento.Id },
                                                new { @class = "gestor-action-link" })

                                            @Html.ActionLink("Tipo Inscrição", "CreateTipoInscricaoSubevento", "TipoInscricao",
                                                new { idEvento = Model.Evento.Id, idSubevento = subevento.Id },
                                                new { @class = "gestor-action-link" })

                                            <a href="#" class="gestor-action-delete" data-bs-toggle="modal" data-bs-target="#modalExcluirSubevento-@subevento.Id">
                                                Excluir
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="linhaSemSubeventoFiltro" class="d-none">
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-search fs-4 d-block mb-1 opacity-50"></i>
                                <span>Nenhum subevento encontrado para o filtro informado.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-diagram-3 fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold d-block">Nenhum subevento cadastrado para este evento.</span>
                                @if (isGestorOuAdmin)
                                {
                                    <div class="mt-3">
                                        <a asp-controller="Subevento" asp-action="CreateOrEdit" asp-route-idEvento="@Model.Evento.Id"
                                           class="btn btn-sm btn-outline-blue-normal rounded-pill px-3">
                                            <i class="bi bi-plus-lg me-1"></i>Criar primeiro subevento
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="gestor-table-footer">
            <div class="text-muted small">
                Exibindo <strong id="lblSubeventosVisiveis">@qtdSubeventos</strong> de <strong>@qtdSubeventos</strong> @(qtdSubeventos == 1 ? "subevento vinculado" : "subeventos vinculados")
            </div>
        </div>
    </section>

    @if (isGestorOuAdmin && subeventos.Any())
    {
        foreach (var subevento in subeventos)
        {
            <partial name="_DeleteModal" model="@(new EventoWeb.Models.DeleteModel {
                ModalId = $"modalExcluirSubevento-{subevento.Id}",
                ActionName = "Delete",
                ControllerName = "Subevento",
                RouteValues = subevento.Id,
                ItemName = subevento.Nome
            })" />
        }
    }
</div>

@section Scripts {
    <script src="~/js/evento-gestor.js" asp-append-version="true"></script>
}
