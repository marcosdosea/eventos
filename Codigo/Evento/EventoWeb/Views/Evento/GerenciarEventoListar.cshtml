@model IEnumerable<EventoWeb.Models.EventoModel>

@{
    ViewData["Title"] = "Gerenciamento de Eventos";
    ViewData["Id"] = "ID";
    ViewData["DataInicio"] = "Data Início";
    ViewData["Nome"] = "Nome do Evento";
    ViewData["NomeTipoEvento"] = "Tipo do Evento";
    var listaEventos = Model?.ToList() ?? new List<EventoWeb.Models.EventoModel>();
    var totalEventos = listaEventos.Count;
}

<link href="~/lib/datatable/css/datatables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/_gerenciarevento.css" asp-append-version="true" />

<div class="gestor-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="gestor-title">@ViewData["Title"]</h1>
            <p class="gestor-subtitle">Selecione um evento para gerenciar inscrições, equipe, frequência, crachás e configurações</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="gestor-count-badge">
                <i class="bi bi-calendar2-week"></i>
                <span>@totalEventos @(totalEventos == 1 ? "evento" : "eventos")</span>
            </span>
            @if (User.IsInRole("ADMINISTRADOR"))
            {
                <a asp-action="Create" class="btn btn-blue-normal color-white rounded-3 px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none">
                    <i class="bi bi-plus-lg"></i>
                    <span>Novo Evento</span>
                </a>
            }
        </div>
    </div>

    @if (listaEventos.Any())
    {
        <div class="gestor-table-card">
            <table id="tableGestorEventListar" class="gestor-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 76px;">@ViewData["Id"]</th>
                        <th style="width: 130px;">@ViewData["DataInicio"]</th>
                        <th>@ViewData["Nome"]</th>
                        <th style="width: 170px;">@ViewData["NomeTipoEvento"]</th>
                        <th style="width: 130px;">Status</th>
                        <th class="text-end" style="width: 145px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listaEventos)
                    {
                        var (statusDescricao, statusClasse) = item.Status switch
                        {
                            "A" => ("Ativo", "gestor-pill-ativo"),
                            "C" => ("Cadastro", "gestor-pill-cadastro"),
                            "F" => ("Finalizado", "gestor-pill-finalizado"),
                            "I" => ("Inativo", "gestor-pill-inativo"),
                            _ => ("Desconhecido", "gestor-pill-finalizado")
                        };

                        <tr>
                            <td class="gestor-col-id" data-order="@item.Id">#@item.Id</td>
                            <td data-order="@(item.DataInicio?.ToString("yyyy-MM-dd") ?? "")">
                                @(item.DataInicio.HasValue ? item.DataInicio.Value.ToString("dd/MM/yyyy") : "-")
                            </td>
                            <td class="fw-semibold text-dark">@item.Nome</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-primary border border-primary-subtle px-3 py-1 fw-semibold">
                                    @item.NomeTipoEvento
                                </span>
                            </td>
                            <td>
                                <span class="gestor-pill @statusClasse">
                                    <span class="dot">●</span>
                                    <span>@statusDescricao</span>
                                </span>
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (User.IsInRole("COLABORADOR") && !User.IsInRole("GESTOR") && !User.IsInRole("ADMINISTRADOR"))
                                    {
                                        <a asp-controller="ParticipacaoPessoaEvento" asp-action="Frequencia" asp-route-idEvento="@item.Id"
                                           class="btn btn-sm btn-blue-normal color-white rounded-3 px-3 fw-semibold" title="Gerenciar Frequência">
                                            <i class="bi bi-calendar-check me-1"></i>Frequência
                                        </a>
                                    }
                                    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("GESTOR"))
                                    {
                                        <a asp-action="GerenciarEvento" asp-route-idEvento="@item.Id"
                                           class="btn btn-sm btn-blue-normal color-white rounded-3 px-3 fw-semibold" title="Gerenciar Evento">
                                            <i class="bi bi-gear me-1"></i>Gerenciar
                                        </a>
                                    }
                                    else if (User.IsInRole("COLABORADOR"))
                                    {
                                        <a asp-action="GerenciarEvento" asp-route-idEvento="@item.Id"
                                           class="btn btn-sm btn-outline-blue-normal rounded-3 px-3 fw-semibold" title="Detalhes do Evento">
                                            <i class="bi bi-info-circle me-1"></i>Detalhes
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="gestor-empty-box mt-2" role="alert">
            <div class="gestor-empty-icon">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">Nenhum evento atribuído</h2>
            <p class="text-muted small mb-0">Você ainda não possui eventos atribuídos para gerenciar.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/datatable/js/datatables.min.js"></script>
    <script id="datatable-script" src="~/js/datatables.js" data-lang-url="@Url.Content("~/lib/datatable/js/pt-BR.json")"></script>
}
