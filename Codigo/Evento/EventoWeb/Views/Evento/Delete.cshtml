@model EventoWeb.Models.EventoModel
@using System.Globalization

@{
    ViewData["Title"] = "Excluir Evento";
    var culturaBr = new CultureInfo("pt-BR");

    var (statusDescricao, statusClasse) = Model.Status switch
    {
        "A" => ("Ativo", "evento-pill-ativo"),
        "C" => ("Cadastro", "evento-pill-cadastro"),
        "F" => ("Finalizado", "evento-pill-finalizado"),
        "I" => ("Inativo", "evento-pill-inativo"),
        _ => ("Desconhecido", "evento-pill-finalizado")
    };

    var cepDigitos = new string((Model.Cep ?? string.Empty).Where(char.IsDigit).ToArray());
    var cepFormatado = cepDigitos.Length == 8
        ? $"{cepDigitos[..5]}-{cepDigitos[5..]}"
        : (string.IsNullOrWhiteSpace(Model.Cep) ? "Não informado" : Model.Cep);

    var enderecoPartes = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Rua))
    {
        enderecoPartes.Add(string.IsNullOrWhiteSpace(Model.Numero) ? Model.Rua.Trim() : $"{Model.Rua.Trim()}, {Model.Numero.Trim()}");
    }
    if (!string.IsNullOrWhiteSpace(Model.Bairro))
    {
        enderecoPartes.Add(Model.Bairro.Trim());
    }
    var cidadeUf = string.Join(" - ", new[] { Model.Cidade?.Trim(), Model.Estado?.Trim() }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (!string.IsNullOrWhiteSpace(cidadeUf))
    {
        enderecoPartes.Add(cidadeUf);
    }
    var enderecoCompleto = enderecoPartes.Any() ? string.Join(" • ", enderecoPartes) : "Não informado";
}

<link rel="stylesheet" href="~/css/evento-admin.css" asp-append-version="true" />

<div class="evento-delete-container">
    <nav class="evento-breadcrumb" aria-label="Navegação estrutural">
        <span class="d-inline-flex align-items-center gap-1">
            <i class="bi bi-house-door"></i>
            <span>Painel Administrativo</span>
        </span>
        <i class="bi bi-chevron-right small opacity-75"></i>
        <a asp-action="Index">Eventos</a>
        <i class="bi bi-chevron-right small opacity-75"></i>
        <span class="evento-breadcrumb-active">Excluir Evento</span>
    </nav>

    <section class="evento-delete-card" aria-labelledby="tituloExcluirEvento">
        <div class="d-flex align-items-start gap-3 mb-3">
            <div class="evento-delete-header-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <h1 id="tituloExcluirEvento" class="h3 blue-normal fw-bold mb-1">Excluir Evento</h1>
                <p class="text-muted small mb-0">Esta ação não poderá ser desfeita. Confirme se realmente deseja remover o evento abaixo.</p>
            </div>
        </div>

        <div class="evento-summary-box">
            <div class="row g-3">
                <div class="col-md-8">
                    <span class="evento-summary-label">Nome do Evento</span>
                    <span class="evento-summary-value fs-6">@Model.Nome</span>
                    <div class="evento-mono-id mt-1">#@Model.Id</div>
                </div>
                <div class="col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-start">
                    <span class="evento-summary-label">Status Atual</span>
                    <span class="evento-pill @statusClasse mt-1">
                        <span class="dot">●</span>
                        <span>@statusDescricao</span>
                    </span>
                </div>

                <div class="col-sm-6">
                    <span class="evento-summary-label">Tipo de Evento</span>
                    <span class="evento-summary-value">@(string.IsNullOrWhiteSpace(Model.NomeTipoEvento) ? "Não informado" : Model.NomeTipoEvento)</span>
                </div>

                <div class="col-sm-6">
                    <span class="evento-summary-label">Publicação no Portal</span>
                    <span class="evento-summary-value">@(Model.EventoPublico == 1 ? "Sim" : "Não")</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                {
                    <div class="col-12">
                        <span class="evento-summary-label">Descrição</span>
                        <span class="evento-summary-value fw-normal text-secondary">@Model.Descricao</span>
                    </div>
                }
            </div>

            <div class="evento-summary-section">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <span class="evento-summary-label">Início do Evento</span>
                        <span class="evento-summary-value">@(Model.DataInicio.HasValue ? Model.DataInicio.Value.ToString("dd/MM/yyyy HH:mm") : "Não definido")</span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <span class="evento-summary-label">Término do Evento</span>
                        <span class="evento-summary-value">@(Model.DataFim.HasValue ? Model.DataFim.Value.ToString("dd/MM/yyyy HH:mm") : "Não definido")</span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <span class="evento-summary-label">Início das Inscrições</span>
                        <span class="evento-summary-value">@(Model.DataInicioInscricao.HasValue ? Model.DataInicioInscricao.Value.ToString("dd/MM/yyyy HH:mm") : "Não definido")</span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <span class="evento-summary-label">Término das Inscrições</span>
                        <span class="evento-summary-value">@(Model.DataFimInscricao.HasValue ? Model.DataFimInscricao.Value.ToString("dd/MM/yyyy HH:mm") : "Não definido")</span>
                    </div>
                </div>
            </div>

            <div class="evento-summary-section">
                <div class="row g-3">
                    <div class="col-md-8">
                        <span class="evento-summary-label">Localização</span>
                        <span class="evento-summary-value">@enderecoCompleto</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Complemento))
                        {
                            <div class="text-muted small mt-1">@Model.Complemento</div>
                        }
                    </div>
                    <div class="col-md-4">
                        <span class="evento-summary-label">CEP</span>
                        <span class="evento-summary-value font-monospace">@cepFormatado</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="evento-summary-label">E-mail de Contato</span>
                        <span class="evento-summary-value">@(string.IsNullOrWhiteSpace(Model.EmailEvento) ? "Não informado" : Model.EmailEvento)</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="evento-summary-label">Website</span>
                        <span class="evento-summary-value">@(string.IsNullOrWhiteSpace(Model.Website) ? "Não informado" : Model.Website)</span>
                    </div>
                </div>
            </div>

            <div class="evento-summary-section">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <span class="evento-summary-label">Vagas (Ofertadas / Reserv. / Disp.)</span>
                        <span class="evento-summary-value font-monospace">@Model.VagasOfertadas / @Model.VagasReservadas / @Model.VagasDisponiveis</span>
                    </div>
                    <div class="col-sm-4">
                        <span class="evento-summary-label">Inscrição Gratuita</span>
                        <span class="evento-summary-value">@(Model.InscricaoGratuita == 1 ? "Sim" : $"Não ({Model.ValorInscricao.ToString("C", culturaBr)})")</span>
                    </div>
                    <div class="col-sm-4">
                        <span class="evento-summary-label">Certificação</span>
                        <span class="evento-summary-value">@(Model.PossuiCertificado == 1 ? $"Sim (mín. {Model.FrequenciaMinimaCertificado:F0}%)" : "Não")</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="evento-summary-label">Carga Horária</span>
                        <span class="evento-summary-value">@Model.CargaHoraria h</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="evento-summary-label">Tempo de Reserva de Vaga</span>
                        <span class="evento-summary-value">@Model.TempoMinutosReserva min</span>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2">
                <a asp-action="Index" class="btn btn-outline-blue-normal rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Cancelar</span>
                </a>

                <button type="submit" class="btn btn-danger rounded-3 px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-trash"></i>
                    <span>Confirmar Exclusão</span>
                </button>
            </div>
        </form>
    </section>
</div>
