@* Views/Modelocertificado/Delete.cshtml *@
@model EventoWeb.Models.ModelocertificadoModel

@{
    ViewData["Title"] = "Excluir Modelo de Certificado";
}

<h1>Excluir Modelo de Certificado</h1>

<h3>Tem certeza que deseja excluir este modelo?</h3>
<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Evento</dt>
            <dd class="col-sm-9">@Model.NomeEvento</dd>

            <dt class="col-sm-3">Texto antes do participante</dt>
            <dd class="col-sm-9">@Model.TextoAntesParticipante</dd>

            <dt class="col-sm-3">Texto antes do evento</dt>
            <dd class="col-sm-10">@Model.TextoAntesEvento</dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" asp-route-idEvento="@(Model.IdEvento == 0 ? (uint?)null : Model.IdEvento)" class="btn btn-secondary">Cancelar</a>
</form>
