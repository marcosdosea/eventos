@model TipoInscricaoModel

@{
    ViewData["Title"] = "Edit";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <link rel="stylesheet" type="text/css" href="~/css/style.css">
</head>


<div class="container-fluid no-padding">
    <div class="row">
        <h1 class="blue-normal">Editar Tipo de Inscrição</h1>
        <div class="row">
            <div>
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <br />
                    <h4 class="blue-normal">
                        Informações Gerais
                    </h4>
                    <div class="form-group mb-2">
                        <label asp-for="Nome" class="control-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-2">
                        <label asp-for="Descricao" class="control-label"></label>
                        <textarea asp-for="Descricao" class="form-control" id="exampleFormControlTextarea1" rows="5"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                    <div class="row">

                        <div class="col-md-10">
                            <div class="form-group mb-2">
                                <label asp-for="IdEvento" class="control-label"></label>
                                <select asp-for="IdEvento" class="form-control" asp-items="Model.Evento" disabled></select>
                                <input type="hidden" asp-for="IdEvento" />
                                <span asp-validation-for="IdEvento" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group" id="valorInscricaoGroup">
                                <label asp-for="Valor" class="control-label"></label>
                                <input asp-for="Valor" asp-format="{0:F2}" type="text" inputmode="decimal" class="form-control" data-val="false" />
                                <span asp-validation-for="Valor" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <br />
                    <h4 class="blue-normal">
                        Datas
                    </h4>
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group mb-2">
                                <label asp-for="DataInicio" class="control-label"></label>
                                <input asp-for="DataInicio" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" class="form-control" type="datetime-local" step="1" />
                                <span asp-validation-for="DataInicio" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-2">
                                <label asp-for="Datafim" class="control-label"></label>
                                <input asp-for="Datafim" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" class="form-control" type="datetime-local" step="1" />
                                <span asp-validation-for="Datafim" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="form-check">
                                        <!-- Checkbox que marca se o evento ser� usado (valor 1) -->
                                        <input class="form-check-input" type="checkbox" value="1" id="UsadaEvento" name="UsadaEvento"
                                        checked="@(Model.UsadaEvento == 1)">
                                        <label class="form-check-label" for="UsadaEvento">Usado em Evento</label>
                                        <!-- Campo oculto para enviar valor 0 quando o checkbox n�o est� marcado -->
                                        <input type="hidden" name="UsadaEvento" value="0">
                                    </div>
                                </div>
                                <span asp-validation-for="UsadaEvento" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="form-check">
                                        <!-- Checkbox que marca se o subevento ser� usado (valor 1) -->
                                        <input class="form-check-input" type="checkbox" value="1" id="UsadaSubevento" name="UsadaSubevento"
                                        checked="@(Model.UsadaSubevento == 1)">
                                        <label class="form-check-label" for="UsadaSubevento">Usado em Subevento</label>
                                        <!-- Campo oculto para enviar valor 0 quando o checkbox n�o est� marcado -->
                                        <input type="hidden" name="UsadaSubevento" value="0">
                                    </div>
                                </div>
                                <span asp-validation-for="UsadaSubevento" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="d-flex justify-content-end">
                        <div class="d-flex flex-row">
                            <div class="form-group" style="margin-right: 10px;">
                                <input type="submit" value="Salvar" class="btn btn-blue-normal color-white" />
                            </div>
                            <div class="form-group">
                                <a asp-action="Index" asp-route-idEvento="@Model.IdEvento" class="btn btn-outline-danger">Cancelar</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('UsadaEvento').addEventListener('change', function () {
            this.nextElementSibling.value = this.checked ? 1 : 0; // Ajusta o valor do campo oculto baseado no estado do checkbox
        });
        document.getElementById('UsadaSubevento').addEventListener('change', function () {
            this.nextElementSibling.value = this.checked ? 1 : 0; // Ajusta o valor do campo oculto baseado no estado do checkbox
        });
    </script>
}
