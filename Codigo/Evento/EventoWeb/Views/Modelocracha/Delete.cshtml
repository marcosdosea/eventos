@model EventoWeb.Models.ModelocrachaModel

@{
    ViewData["Title"] = "Excluir Modelo de Crachá";
    var eventoNome = Model.NomeEvento ?? Model.Evento?.Nome ?? "Evento Vinculado";
}

<link rel="stylesheet" href="~/css/modelocracha.css" asp-append-version="true" />

<div class="cracha-delete-container">
    <div class="cracha-delete-card">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="delete-header-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <h2 class="blue-normal fw-bold mb-1">Excluir Modelo de Crachá</h2>
                <p class="text-muted small mb-0">Esta ação não poderá ser desfeita. Confirme se realmente deseja remover o modelo abaixo.</p>
            </div>
        </div>

        <div class="info-summary-box">
            <div class="row g-3">
                <div class="col-12">
                    <span class="text-muted small fw-semibold d-block">Evento Vinculado</span>
                    <span class="fw-bold text-dark fs-6">@eventoNome</span>
                </div>

                <div class="col-12">
                    <span class="text-muted small fw-semibold d-block">Texto do Crachá</span>
                    <span class="text-secondary small fst-italic">"@Model.Texto"</span>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted small fw-semibold d-block mb-1">Logotipo Institucional</span>
                    <div class="logo-preview-box">
                        @if (!string.IsNullOrEmpty(Model.LogotipoBase64))
                        {
                            <img src="data:image/png;base64,@Model.LogotipoBase64" alt="Logotipo" />
                        }
                        else
                        {
                            <i class="bi bi-image text-muted fs-3"></i>
                        }
                    </div>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted small fw-semibold d-block mb-1">Impressão de QR Code</span>
                    @if (Model.Qrcode == 1)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 fw-semibold">
                            ● Habilitado
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2 fw-semibold">
                            ● Desabilitado
                        </span>
                    }
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="idEvento" value="@Model.IdEvento" />

            <div class="d-flex align-items-center justify-content-between pt-2">
                <a asp-action="Index" asp-route-idEvento="@Model.IdEvento" class="btn btn-outline-blue-normal px-4 py-2 rounded-3 fw-semibold">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-trash"></i>
                    <span>Confirmar Exclusão</span>
                </button>
            </div>
        </form>
    </div>
</div>
