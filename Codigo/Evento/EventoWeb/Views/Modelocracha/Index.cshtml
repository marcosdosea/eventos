@model IEnumerable<EventoWeb.Models.ModelocrachaModel>

@{
    ViewData["Title"] = "Modelos de Crachás";
    var eventoId = ViewData["EventoId"];
    var eventoNome = ViewData["EventoNome"]?.ToString() ?? "Todos os Eventos";
}

<style>
    .cracha-page-container {
        padding: 1.5rem 0 3rem 0;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .cracha-title {
        color: #232ed0;
        font-weight: 700;
        font-size: 1.85rem;
        letter-spacing: -0.3px;
        margin: 0;
    }

    .cracha-search-box {
        position: relative;
        display: flex;
        align-items: center;
        background-color: #F1F4FA;
        border: 1px solid #E2E8F0;
        border-radius: 50px;
        padding: 6px 16px;
        min-width: 290px;
        transition: all 0.2s ease;
    }

    .cracha-search-box:focus-within {
        background-color: #FFFFFF;
        border-color: #232ed0;
        box-shadow: 0 0 0 3px rgba(35, 46, 208, 0.12);
    }

    .cracha-search-input {
        border: none;
        background: transparent;
        outline: none;
        width: 100%;
        font-size: 0.9rem;
        color: #334155;
    }

    .cracha-search-input::placeholder {
        color: #94A3B8;
        font-size: 0.88rem;
    }

    .cracha-filter-btn {
        background-color: #F1F4FA;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .cracha-filter-btn:hover {
        background-color: #E2E8F0;
        color: #232ed0;
    }

    .cracha-table-card {
        background: #FFFFFF;
        border-radius: 16px;
        border: 1px solid #EDF2F7;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        margin-top: 1.5rem;
    }

    .cracha-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .cracha-table thead tr {
        background-color: #EDF2FB;
    }

    .cracha-table thead th {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1E293B;
        padding: 16px 20px;
        border: none;
        vertical-align: middle;
    }

    .cracha-table tbody tr {
        transition: background-color 0.15s ease;
        border-bottom: 1px solid #F1F5F9;
    }

    .cracha-table tbody tr:hover {
        background-color: #F8FAFC;
    }

    .cracha-table tbody td {
        padding: 16px 20px;
        font-size: 0.92rem;
        color: #334155;
        vertical-align: middle;
        border-top: 1px solid #F1F5F9;
        border-bottom: none;
    }

    .col-id-badge {
        color: #232ed0;
        font-weight: 700;
        font-size: 0.95rem;
        width: 40px;
        text-align: center;
    }

    .col-evento-nome {
        font-weight: 600;
        color: #0F172A;
        line-height: 1.35;
        max-width: 300px;
    }

    .logo-thumb-box {
        width: 46px;
        height: 46px;
        background-color: #EEF2F6;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .logo-thumb-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .texto-mono-preview {
        font-family: 'Consolas', 'Menlo', 'Monaco', monospace;
        font-size: 0.85rem;
        color: #475569;
        max-width: 340px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .badge-qrcode-sim {
        background-color: #D1FAE5;
        color: #065F46;
        border-radius: 50px;
        padding: 6px 14px;
        font-weight: 600;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-qrcode-sim .dot {
        color: #10B981;
        font-size: 0.75rem;
    }

    .badge-qrcode-nao {
        background-color: #E2E8F0;
        color: #475569;
        border-radius: 50px;
        padding: 6px 14px;
        font-weight: 600;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-qrcode-nao .dot {
        color: #94A3B8;
        font-size: 0.75rem;
    }

    .action-link-edit {
        color: #232ed0;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .action-link-edit:hover {
        color: #151c7d;
        text-decoration: underline;
    }

    .action-link-delete {
        color: #dc3545;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .action-link-delete:hover {
        color: #b02a37;
        text-decoration: underline;
    }

    .table-footer-bar {
        padding: 16px 20px;
        background-color: #FFFFFF;
        border-top: 1px solid #F1F5F9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .pagination-custom .page-btn {
        background-color: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #232ed0;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .pagination-custom .page-btn:hover {
        background-color: #F8FAFC;
        border-color: #CBD5E1;
        color: #151c7d;
    }

    .pagination-custom .page-btn.active {
        background-color: #232ed0;
        border-color: #232ed0;
        color: #FFFFFF !important;
        font-weight: 600;
    }
</style>

<div class="cracha-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
        <h1 class="cracha-title blue-normal">Histórico de Modelos de Crachás Cadastrados</h1>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="cracha-search-box">
                <i class="bi bi-search text-muted me-2"></i>
                <input type="text" id="filtroModelos" class="cracha-search-input" placeholder="Filtrar modelos cadastrados..." />
            </div>

            <button type="button" class="cracha-filter-btn" title="Filtro avançado" id="btnToggleFiltro">
                <i class="bi bi-sliders"></i>
            </button>

            <a asp-action="Create" asp-route-idEvento="@eventoId" class="btn btn-blue-normal color-white px-3 py-2 rounded-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Novo Modelo</span>
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mt-3" role="alert">
            <div asp-validation-summary="All" class="mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="cracha-table-card">
        <div class="table-responsive">
            <table class="cracha-table" id="tabelaModelosCrachas">
                <thead>
                    <tr>
                        <th class="col-id-badge">#</th>
                        <th style="min-width: 260px;">Evento</th>
                        <th style="width: 100px; text-align: center;">Logo</th>
                        <th style="min-width: 280px;">Texto</th>
                        <th style="width: 140px; text-align: center;">QR Code</th>
                        <th style="width: 160px; text-align: right;">Ações</th>
                    </tr>
                </thead>
                <tbody id="tabelaModelosBody">
                    @{
                        int index = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="linha-modelo" data-evento="@item.NomeEvento" data-texto="@item.Texto">
                                <td class="col-id-badge">@index</td>
                                <td>
                                    <div class="col-evento-nome">@item.NomeEvento</div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <div class="logo-thumb-box" title="Logotipo do Modelo">
                                            @if (!string.IsNullOrEmpty(item.LogotipoBase64))
                                            {
                                                <img src="data:image/png;base64,@item.LogotipoBase64" alt="Logotipo" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-muted fs-5"></i>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="texto-mono-preview" title="@item.Texto">@item.Texto</span>
                                </td>
                                <td style="text-align: center;">
                                    @if (item.Qrcode == 1)
                                    {
                                        <span class="badge-qrcode-sim">
                                            <span class="dot">●</span> Sim
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-qrcode-nao">
                                            <span class="dot">●</span> Não
                                        </span>
                                    }
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-link-edit blue-normal me-3">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-link-delete danger-normal me-2">Excluir</a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr id="linhaVazia">
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-person-badge fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold">Nenhum modelo de crachá cadastrado para este evento.</span>
                                <div class="mt-3">
                                    <a asp-action="Create" asp-route-idEvento="@eventoId" class="btn btn-sm btn-outline-blue-normal rounded-pill px-3">
                                        <i class="bi bi-plus-lg me-1"></i> Criar primeiro modelo
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-bar">
            <div class="text-muted small">
                Exibindo <strong id="lblContagemExibidos">1-@(Model?.Count() ?? 0)</strong> de <strong id="lblContagemTotal">@(Model?.Count() ?? 0)</strong> modelos homologados
            </div>

            <div class="pagination-custom d-flex align-items-center gap-1" id="paginacaoNav">
                <button type="button" class="page-btn" id="btnPaginaAnterior" disabled>Anterior</button>
                <button type="button" class="page-btn active" id="btnPagina1">1</button>
                <button type="button" class="page-btn" id="btnPaginaProximo" disabled>Próximo</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filtroInput = document.getElementById("filtroModelos");
            const tabelaBody = document.getElementById("tabelaModelosBody");
            const linhas = Array.from(tabelaBody.querySelectorAll(".linha-modelo"));
            const lblExibidos = document.getElementById("lblContagemExibidos");

            filtroInput.addEventListener("input", function () {
                const termo = filtroInput.value.toLowerCase().trim();
                let exibidos = 0;

                linhas.forEach(linha => {
                    const evento = (linha.getAttribute("data-evento") || "").toLowerCase();
                    const texto = (linha.getAttribute("data-texto") || "").toLowerCase();

                    if (!termo || evento.includes(termo) || texto.includes(termo)) {
                        linha.style.display = "";
                        exibidos++;
                    } else {
                        linha.style.display = "none";
                    }
                });

                if (lblExibidos) {
                    if (exibidos === 0) {
                        lblExibidos.textContent = "0";
                    } else {
                        lblExibidos.textContent = `1-${exibidos}`;
                    }
                }
            });
        });
    </script>
}