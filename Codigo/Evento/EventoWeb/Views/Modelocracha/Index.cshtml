@model IEnumerable<EventoWeb.Models.ModelocrachaModel>

@{
    ViewData["Title"] = "Modelos de Crachás";
    var eventoId = ViewData["EventoId"];
    var eventoNome = ViewData["EventoNome"]?.ToString() ?? "Todos os Eventos";
}

<link rel="stylesheet" href="~/css/modelocracha.css" asp-append-version="true" />

<div class="cracha-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
        <h1 class="cracha-title blue-normal">Modelos de Crachás</h1>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="cracha-search-box">
                <i class="bi bi-search text-muted me-2"></i>
                <input type="text" id="filtroModelos" class="cracha-search-input" placeholder="Filtrar modelos cadastrados..." />
            </div>
            <a asp-action="Create" asp-route-idEvento="@eventoId" class="btn btn-blue-normal color-white px-3 py-2 rounded-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Novo Modelo</span>
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mt-3" role="alert">
            <div asp-validation-summary="All" class="mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="cracha-table-card">
        <div class="table-responsive">
            <table class="cracha-table" id="tabelaModelosCrachas">
                <thead>
                    <tr>
                        <th class="col-id-badge">#</th>
                        <th style="min-width: 260px;">Evento</th>
                        <th style="width: 100px; text-align: center;">Logo</th>
                        <th style="min-width: 280px;">Texto</th>
                        <th style="width: 140px; text-align: center;">QR Code</th>
                        <th style="width: 160px; text-align: right;">Ações</th>
                    </tr>
                </thead>
                <tbody id="tabelaModelosBody">
                    @{
                        int index = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="linha-modelo" data-evento="@item.NomeEvento" data-texto="@item.Texto">
                                <td class="col-id-badge">@index</td>
                                <td>
                                    <div class="col-evento-nome">@item.NomeEvento</div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <div class="logo-thumb-box" title="Logotipo do Modelo">
                                            @if (!string.IsNullOrEmpty(item.LogotipoBase64))
                                            {
                                                <img src="data:image/png;base64,@item.LogotipoBase64" alt="Logotipo" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-muted fs-5"></i>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="texto-mono-preview" title="@item.Texto">@item.Texto</span>
                                </td>
                                <td style="text-align: center;">
                                    @if (item.Qrcode == 1)
                                    {
                                        <span class="badge-qrcode-sim">
                                            <span class="dot">●</span> Sim
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-qrcode-nao">
                                            <span class="dot">●</span> Não
                                        </span>
                                    }
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-link-edit blue-normal me-3">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-link-delete danger-normal me-2">Excluir</a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr id="linhaVazia">
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-person-badge fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold">Nenhum modelo de crachá cadastrado para este evento.</span>
                                <div class="mt-3">
                                    <a asp-action="Create" asp-route-idEvento="@eventoId" class="btn btn-sm btn-outline-blue-normal rounded-pill px-3">
                                        <i class="bi bi-plus-lg me-1"></i> Criar primeiro modelo
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-bar">
            <div class="text-muted small">
                Exibindo <strong id="lblContagemExibidos">1-@(Model?.Count() ?? 0)</strong> de <strong id="lblContagemTotal">@(Model?.Count() ?? 0)</strong> modelos homologados
            </div>

            <div class="pagination-custom d-flex align-items-center gap-1" id="paginacaoNav">
                <button type="button" class="page-btn" id="btnPaginaAnterior" disabled>Anterior</button>
                <button type="button" class="page-btn active" id="btnPagina1">1</button>
                <button type="button" class="page-btn" id="btnPaginaProximo" disabled>Próximo</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filtroInput = document.getElementById("filtroModelos");
            const tabelaBody = document.getElementById("tabelaModelosBody");
            const linhas = Array.from(tabelaBody.querySelectorAll(".linha-modelo"));
            const lblExibidos = document.getElementById("lblContagemExibidos");

            filtroInput.addEventListener("input", function () {
                const termo = filtroInput.value.toLowerCase().trim();
                let exibidos = 0;

                linhas.forEach(linha => {
                    const evento = (linha.getAttribute("data-evento") || "").toLowerCase();
                    const texto = (linha.getAttribute("data-texto") || "").toLowerCase();

                    if (!termo || evento.includes(termo) || texto.includes(termo)) {
                        linha.style.display = "";
                        exibidos++;
                    } else {
                        linha.style.display = "none";
                    }
                });

                if (lblExibidos) {
                    if (exibidos === 0) {
                        lblExibidos.textContent = "0";
                    } else {
                        lblExibidos.textContent = `1-${exibidos}`;
                    }
                }
            });
        });
    </script>
}