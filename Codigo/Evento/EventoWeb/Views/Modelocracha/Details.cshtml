@model EventoWeb.Models.ModelocrachaModel

@{
    ViewData["Title"] = "Details";
}

<h1 class="blue-normal">Detalhes do Modelo</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdEvento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NomeEvento)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Texto)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Texto)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Logotipo)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.LogotipoBase64))
            {
                <img src="data:image/png;base64,@Model.LogotipoBase64" alt="Logotipo" style="width:200px;height:200px;object-fit:contain;" />
            }
            else
            {
                <span>Sem logotipo</span>
            }
        </dd>
        <dt class="col-sm-2">
            Crachás com QR Code
        </dt>
        <dd class="col-sm-10">
            @if (Model.Crachas != null && Model.Crachas.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var cracha in Model.Crachas)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border text-center p-3">
                                <h5 class="fw-bold text-primary mb-1">@cracha.NomeCracha</h5>
                                @if (!string.Equals(cracha.NomeCracha, cracha.Nome, StringComparison.OrdinalIgnoreCase))
                                {
                                    <p class="text-muted small mb-2">@cracha.Nome</p>
                                }
                                <div class="mt-2">
                                    <img src="data:image/png;base64,@cracha.QrCodeBase64" alt="QR Code de @cracha.NomeCracha" style="width:160px;height:160px;object-fit:contain;" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Model.QrCodes != null && Model.QrCodes.Any())
            {
                @foreach (var qrCode in Model.QrCodes)
                {
                    <img src="data:image/png;base64,@qrCode" alt="QR Code" style="width:200px;height:200px;object-fit:contain;" />
                    <br />
                }
            }
            else
            {
                <span>Sem QR Codes</span>
            }
        </dd>
    </dl>
</div>

<div>
    <div class="row">
        <div class="col-auto">
            <a href="@Url.Action("Index", "Modelocracha", new { idEvento = Model.IdEvento, idPessoa = Model.IdPessoa})" class="btn btn-outline-danger">Voltar</a>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-blue-normal" onclick="location.href='@Url.Action("Edit", new { id = Model.Id })'">
                Editar
            </button>
        </div>
    </div>
</div>
