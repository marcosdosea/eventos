@model EventoWeb.Models.ModelocrachaModel

@{
    ViewData["Title"] = "Detalhes do Modelo de Crachá";
    var eventoNome = Model.NomeEvento ?? Model.Evento?.Nome ?? "Evento Vinculado";
}

<link rel="stylesheet" href="~/css/modelocracha.css" asp-append-version="true" />

<div class="cracha-details-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <h1 class="cracha-title blue-normal">Detalhes do Modelo de Crachá</h1>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Modelocracha", new { idEvento = Model.IdEvento, idPessoa = Model.IdPessoa })" class="btn btn-outline-danger px-3 py-2 rounded-3 fw-semibold text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-blue-normal color-white px-3 py-2 rounded-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-pencil-square"></i>
                <span>Editar Modelo</span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card-details">
                <h5 class="fw-bold mb-4 text-dark">Informações do Modelo</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small fw-semibold">Evento Vinculado</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@eventoNome</dd>

                    <dt class="col-sm-4 text-muted small fw-semibold">Texto do Crachá</dt>
                    <dd class="col-sm-8 text-secondary small fst-italic">@Model.Texto</dd>

                    <dt class="col-sm-4 text-muted small fw-semibold">Status QR Code</dt>
                    <dd class="col-sm-8">
                        @if (Model.Qrcode == 1)
                        {
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-1 fw-semibold">
                                ● Habilitado
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-1 fw-semibold">
                                ● Desabilitado
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small fw-semibold">Logotipo</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.LogotipoBase64))
                        {
                            <div class="p-2 border rounded-3 bg-light d-inline-block" style="width: 140px; height: 70px;">
                                <img src="data:image/png;base64,@Model.LogotipoBase64" alt="Logotipo" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Sem logotipo</span>
                        }
                    </dd>

                    @if (Model.QrCodes != null && Model.QrCodes.Any())
                    {
                        <dt class="col-sm-4 text-muted small fw-semibold mt-3">QR Codes de Inscritos</dt>
                        <dd class="col-sm-8 mt-3">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var qr in Model.QrCodes)
                                {
                                    <div class="p-1 border rounded bg-white shadow-sm" style="width: 70px; height: 70px;">
                                        <img src="data:image/png;base64,@qr" alt="QR Code" style="width: 100%; height: 100%; object-fit: contain;" />
                                    </div>
                                }
                            </div>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="preview-card-container">
                <div class="lanyard-strap">
                    <span class="lanyard-strap-text">BORA LÁ</span>
                </div>
                <div class="lanyard-clip"></div>

                <div class="cracha-physical-card">
                    <div class="cracha-hole"></div>

                    <div class="cracha-header">
                        <div class="cracha-header-sub">
                            <span class="cracha-header-sub-icon">
                                <i class="bi bi-person-vcard-fill"></i>
                            </span>
                            <span>BORA LÁ EVENTOS</span>
                        </div>
                        <h6 class="cracha-evento-title">@eventoNome</h6>
                    </div>

                    <div class="cracha-body">
                        <div class="participant-avatar-wrapper">
                            <svg class="participant-avatar-img" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="50" cy="50" r="50" fill="#E2E8F0"/>
                                <circle cx="50" cy="38" r="20" fill="#475569"/>
                                <path d="M16 88C16 70 30 64 50 64C70 64 84 70 84 88" fill="#1E293B"/>
                            </svg>
                        </div>

                        <div class="participant-name">RICARDO LACERDA</div>
                        <div class="participant-org">Instituto de Pesquisa & Inovação</div>
                        <div class="badge-role-pill">PARTICIPANTE</div>

                        @if (Model.Qrcode == 1)
                        {
                            <div class="cracha-qrcode-box">
                                @if (Model.QrCodes != null && Model.QrCodes.Any())
                                {
                                    <img src="data:image/png;base64,@Model.QrCodes.First()" alt="QR Code" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 100 100" width="74" height="74">
                                        <rect width="100" height="100" fill="#FFFFFF"/>
                                        <rect x="10" y="10" width="30" height="30" fill="#0F172A"/>
                                        <rect x="16" y="16" width="18" height="18" fill="#FFFFFF"/>
                                        <rect x="20" y="20" width="10" height="10" fill="#0F172A"/>
                                        <rect x="60" y="10" width="30" height="30" fill="#0F172A"/>
                                        <rect x="66" y="16" width="18" height="18" fill="#FFFFFF"/>
                                        <rect x="70" y="20" width="10" height="10" fill="#0F172A"/>
                                        <rect x="10" y="60" width="30" height="30" fill="#0F172A"/>
                                        <rect x="16" y="66" width="18" height="18" fill="#FFFFFF"/>
                                        <rect x="20" y="70" width="10" height="10" fill="#0F172A"/>
                                        <rect x="46" y="12" width="8" height="8" fill="#0F172A"/>
                                        <rect x="46" y="26" width="8" height="16" fill="#0F172A"/>
                                        <rect x="12" y="46" width="12" height="8" fill="#0F172A"/>
                                        <rect x="30" y="46" width="14" height="8" fill="#0F172A"/>
                                        <rect x="50" y="50" width="12" height="12" fill="#0F172A"/>
                                        <rect x="68" y="48" width="10" height="8" fill="#0F172A"/>
                                        <rect x="84" y="48" width="8" height="14" fill="#0F172A"/>
                                        <rect x="48" y="70" width="10" height="18" fill="#0F172A"/>
                                        <rect x="66" y="66" width="14" height="10" fill="#0F172A"/>
                                        <rect x="66" y="80" width="22" height="10" fill="#0F172A"/>
                                    </svg>
                                }
                            </div>
                        }
                    </div>

                    <div class="cracha-footer">
                        <p class="cracha-footer-text">@Model.Texto</p>
                    </div>
                </div>

                <div class="watermark-scale">90×130 mm</div>
            </div>
        </div>
    </div>
</div>
