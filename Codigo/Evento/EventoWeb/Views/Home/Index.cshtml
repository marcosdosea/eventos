@model IEnumerable<EventoWeb.Models.EventoModel>

@{
    ViewData["Title"] = "BoraLá";

    var eventosGerenciadosIds = ViewBag.EventosGerenciadosIds as HashSet<uint> ?? new HashSet<uint>();
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/_Layout_Inicio.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>

    <main>
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-danger" role="alert" id="alerterror">
                @TempData["Message"]
            </div>
            TempData.Remove("Message");
        }
        @if (TempData["ParticipanteMessage"] != null)
        {
            <div class="alert alert-info" role="alert" id="alertinfo">
                @TempData["ParticipanteMessage"]
            </div>
            TempData.Remove("ParticipanteMessage");
        }
        <script>
            setTimeout(function () {
                $("#alerterror").fadeOut("slow");
                $("#alertinfo").fadeOut("slow");
            }, 3000);
        </script>
            <section class="categorias">
                <h1>Encontre o evento ideal!</h1>
                <div class="categorias-list-container">
                    <ul class="categorias-list">
                        <li>
                            <a href="#">
                                <img src="~/ícones/Palestras.png" alt="Palestras">
                                <span>Palestras</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <img src="~/ícones/Teatros.png" alt="Teatros">
                                <span>Teatros</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <img src="~/ícones/Shows.png" alt="Shows" class="i">
                                <span>Shows</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <img src="~/ícones/Stand-up.png" alt="Stand-up">
                                <span>Stand-Up</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <img src="~/ícones/Culturais.png" alt="Culturais">
                                <span>Culturais</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <img src="~/ícones/Religiosos.png" alt="Religiosos">
                                <span>Religiosos</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </section>

    

            <section class="carrossel">
                <div class="carrossel-container">
                    <div class="carrossel-slide">
                        <img src="~/Imagens_Eventos/Evento-Semac.png" alt="IV SEMAC">
                        <div class="carrossel-content">
                            <h2>IV SEMAC</h2>
                            <p>“Emergências contemporâneas e transformação social”</p>
                        </div>
                    </div>
                    <div class="carrossel-slide">
                        <img src="~/Imagens_Eventos/Evento-Jazz.png" alt="IV SEMAC">
                        <div class="carrossel-content">
                            <h2>Jazz Under the Stars</h2>
                            <p>“A noite do Jazz”</p>
                        </div>
                    </div>
                    <div class="carrossel-slide">
                        <img src="~/Imagens_Eventos/Evento-Rock.png" alt="IV SEMAC">
                        <div class="carrossel-content">
                            <h2>Rock Fest 2024</h2>
                            <p>“Festival de Rock”</p>
                        </div>
                    </div>
                    <div class="carrossel-slide">
                        <img src="~/Imagens_Eventos/Evento-Eletronica.png" alt="IV SEMAC">
                        <div class="carrossel-content">
                            <h2>EDM Festival</h2>
                            <p>“Festival de música eletrônica”</p>
                        </div>
                    </div>
                </div>
                <div class="carrossel-indicators">
                    <span class="indicator active" onclick="currentSlide(0)"></span>
                    <span class="indicator" onclick="currentSlide(1)"></span>
                    <span class="indicator" onclick="currentSlide(2)"></span>
                    <span class="indicator" onclick="currentSlide(3)"></span>
                </div>
                <button class="carrossel-btn prev" onclick="moveSlide(-1)">&#10094;</button>
                <button class="carrossel-btn next" onclick="moveSlide(1)">&#10095;</button>
            </section>

            @{
                var estadoAtivo = ViewBag.EstadoAtivo as string;
                var nomeEstadoAtivo = ViewBag.NomeEstadoAtivo as string ?? (string.IsNullOrEmpty(estadoAtivo) ? "Todo o Brasil" : estadoAtivo);
                bool temEventos = Model != null && Model.Any();
            }

            @if (!temEventos)
            {
                <section class="eventos-empty-state my-5 px-3">
                    <div class="text-center p-5 mx-auto rounded-4 shadow-sm border bg-white" style="max-width: 650px;">
                        <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                        <h4 class="fw-bold text-dark mb-2">
                            Nenhum evento com inscrições abertas ou em breve encontrado em @(nomeEstadoAtivo).
                        </h4>
                        <p class="text-muted mb-4">
                            Não encontramos eventos com inscrições ativas ou futuras para esta localização. Que tal explorar os eventos disponíveis em outras regiões?
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            @if (!string.IsNullOrEmpty(estadoAtivo))
                            {
                                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="clearManualLocation()">
                                    <i class="bi bi-globe me-1"></i> Ver eventos em Todo o Brasil
                                </button>
                            }
                            <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="openLocationModal()">
                                <i class="bi bi-geo-alt me-1"></i> Trocar de Estado
                            </button>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <section class="eventos">
                    <div class="section-header d-flex justify-content-between align-items-center">
                        <h1>Recomendações</h1>
                        <a asp-action="Buscar" asp-controller="Home" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="btn-ver-todos ver-todos-link">
                            <span>Ver todos</span>
                            <span class="btn-ver-todos-icon"><i class="bi bi-arrow-right"></i></span>
                        </a>
                    </div>
                    <div class="scroll-wrapper">
                        <div class="cards-container">
                            @{
                                var todosRecomendados = Model?.Where(e => e.Status == "A").ToList() ?? new List<EventoWeb.Models.EventoModel>();
                                var eventosRecomendados = todosRecomendados.Take(10).ToList();
                                bool temMaisRecomendados = todosRecomendados.Count > 10;

                                if (eventosRecomendados.Count > 0)
                                {
                                    foreach (var evento in eventosRecomendados)
                                    {
                                        bool inscricaoAberta = (!evento.DataInicioInscricao.HasValue || evento.DataInicioInscricao <= DateTime.Now) && (!evento.DataFimInscricao.HasValue || evento.DataFimInscricao >= DateTime.Now);
                                        bool inscricaoFutura = evento.DataInicioInscricao.HasValue && evento.DataInicioInscricao > DateTime.Now;
                                        bool eventoGratuito = evento.InscricaoGratuita == 1 || evento.ValorInscricao == 0;

                                        <div class="card">
                                            <div style="position: relative; line-height: 0;">
                                                <img src="~/Imagens_Eventos/Evento-BoraLa.png" alt="Imagem do Evento" style="width: 100%;">
                                                <div class="badges-container" style="position: absolute; bottom: 8px; left: 8px; display: flex; flex-direction: column; gap: 4px; align-items: flex-start; margin: 0;">
                                                    @if (inscricaoAberta)
                                                    {
                                                        <span class="badge badge-open">Inscrições Abertas</span>
                                                    }
                                                    else if (inscricaoFutura)
                                                    {
                                                        <span class="badge badge-future">Em breve</span>
                                                    }

                                                    @if (eventoGratuito)
                                                    {
                                                        <span class="badge badge-free">Gratuito</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark border-0 rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.8rem; font-weight: 600;">R$ @evento.ValorInscricao.ToString("F2")</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="card-content">
                                                <h2>@evento.Nome</h2>
                                                @{
                                                    var descricaoCompleta = string.IsNullOrWhiteSpace(evento.Descricao)
                                                        ? "Descrição indisponível"
                                                        : evento.Descricao;
                                                }
                                                <p class="card-description">@descricaoCompleta</p>
                                                @if (eventosGerenciadosIds.Contains(evento.Id))
                                                {
                                                    <a asp-action="GerenciarEvento" asp-controller="Evento" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal"><i class="bi bi-gear"></i> Gerenciar</button>
                                                    </a>
                                                }
                                                else if (inscricaoAberta)
                                                {
                                                    <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal">Bora lá</button>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal">Ver Detalhes</button>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    if (temMaisRecomendados)
                                    {
                                        <a asp-action="Buscar" asp-controller="Home" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="card card-ver-mais text-decoration-none">
                                            <div class="card-ver-mais-top">
                                                <span class="card-ver-mais-badge">
                                                    <i class="bi bi-stars"></i> Recomendações
                                                </span>
                                            </div>
                                            <div class="card-ver-mais-center">
                                                <div class="card-ver-mais-icon">
                                                    <i class="bi bi-grid-fill"></i>
                                                </div>
                                                <h3 class="card-ver-mais-title">Ver mais eventos</h3>
                                                <p class="card-ver-mais-text">Explore todas as opções recomendadas para você</p>
                                            </div>
                                            <div class="card-ver-mais-bottom">
                                                <span class="card-ver-mais-action">
                                                    <span>Explorar tudo</span>
                                                    <i class="bi bi-arrow-right"></i>
                                                </span>
                                            </div>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <p>Não há eventos para exibir.</p>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section class="eventos">
                    <div class="section-header d-flex justify-content-between align-items-center">
                        <h1>Shows</h1>
                        <a asp-action="Buscar" asp-controller="Home" asp-route-IdTipoEvento="6" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="btn-ver-todos ver-todos-link">
