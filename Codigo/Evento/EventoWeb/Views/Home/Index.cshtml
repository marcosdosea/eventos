                                                    var descricaoCompleta = string.IsNullOrWhiteSpace(evento.Descricao)
                                                        ? "Descrição indisponível"
                                                        : evento.Descricao;
                                                }
                                                <p class="card-description">@descricaoCompleta</p>
                                                @if (eventosGerenciadosIds.Contains(evento.Id))
                                                {
                                                    <a asp-action="GerenciarEvento" asp-controller="Evento" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal"><i class="bi bi-gear"></i> Gerenciar</button>
                                                    </a>
                                                }
                                                else if (inscricaoAberta)
                                                {
                                                    <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal">Bora lá</button>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="realizarInscricao" asp-controller="Inscricao" asp-route-idEvento="@evento.Id">
                                                        <button class="btn btn-blue-normal">Ver Detalhes</button>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    if (temMaisWorkshop)
                                    {
                                        <a asp-action="Buscar" asp-controller="Home" asp-route-IdTipoEvento="5" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="card card-ver-mais text-decoration-none">
                                            <div class="card-ver-mais-top">
                                                <span class="card-ver-mais-badge">
                                                    <i class="bi bi-laptop"></i> Workshops
                                                </span>
                                            </div>
                                            <div class="card-ver-mais-center">
                                                <div class="card-ver-mais-icon">
                                                    <i class="bi bi-tools"></i>
                                                </div>
                                                <h3 class="card-ver-mais-title">Ver mais workshops</h3>
                                                <p class="card-ver-mais-text">Explore todos os cursos e oficinas práticas</p>
                                            </div>
                                            <div class="card-ver-mais-bottom">
                                                <span class="card-ver-mais-action">
                                                    <span>Explorar tudo</span>
                                                    <i class="bi bi-arrow-right"></i>
                                                </span>
                                            </div>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <p>Não há eventos para exibir.</p>
                                }
                            }
                        </div>
                    </div>
                </section>
            }

            <section class="destaque">
                <div class="destaque-content">
                    <h1>Crie seu evento</h1>
                    <p>Você está planejando um evento e quer garantir<br> que ele alcance o máximo de pessoas possíveis? <br>O Boralá é o lugar certo para você!</p>
                    <a href="/Evento" class="btn btn-blue-normal">Criar meu evento!</a>
                </div>
            </section>

            <script src="~/js/carrossel.js"></script>

    </main>
    @{
        var modalExibe = TempData["SelecionarPerfil"]?.ToString() ?? "false";
    }

    <partial name="_SelecionarPerfil" model="modalExibe" />
    
</body>

</html>




