                        <a asp-action="Buscar" asp-controller="Home" asp-route-IdTipoEvento="5" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="btn-ver-todos ver-todos-link">
