                                                        <button class="btn btn-blue-normal">Ver Detalhes</button>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    if (temMaisPalestra)
                                    {
                                        <a asp-action="Buscar" asp-controller="Home" asp-route-IdTipoEvento="1" asp-route-Estado="@(string.IsNullOrWhiteSpace(estadoAtivo) ? null : estadoAtivo)" class="card card-ver-mais text-decoration-none">
                                            <div class="card-ver-mais-top">
