@model EventoWeb.Models.FrequenciaViewModel

<link href="~/lib/datatable/css/datatables.min.css" rel="stylesheet" />

<h1 class="blue-normal">Participação do Participante</h1>
<hr />

<div class="row mb-4 align-items-start">
    <div class="col-md-8">
        <div class="mb-3">
            <strong>Nome:</strong> @Model.Evento.Nome
        </div>
        <div class="mb-3">
            <strong>Sub evento:</strong> @Model.SubEvento?.Nome
        </div>
    </div>
    <div class="col-md-4 text-md-end">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalImportarCsv">
            <i class="bi bi-upload me-1"></i> Importar CSV
        </button>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <form id="participacaoForm" asp-action="RegistrarParticipacao" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idEvento" value="@Model.Evento.Id" />
            @if (Model.SubEvento != null)
            {
                <input type="hidden" name="idSubEvento" value="@Model.SubEvento.Id" />
            }
            <div class="form-group">
                <label for="cpf">CPF</label>
                <div class="d-flex">
                    <input type="text" id="cpf" name="cpf" class="form-control me-2" placeholder="000.000.000-00" required 
                           pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" title="Digite um CPF válido no formato 000.000.000-00"/>
                    <button type="submit" class="btn btn-primary">Adicionar Participação</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <table id="tabelaParticipacao" class="table table-striped">
            <thead class="blue-normal blue-normal-bg-table">
                <tr>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Data e Hora</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Frequencias != null)
                {
                    foreach (var participacao in Model.Frequencias)
                    {
                    <tr>
                        <td>@participacao.IdPessoaNavigation?.Nome</td>
                        <td>@(participacao.Saida.HasValue ? "Saída" : "Entrada")</td>
                        <td>@(participacao.Saida.HasValue ? participacao.Saida.Value.ToString("dd/MM/yyyy às HH:mm\\h") : participacao.Entrada.ToString("dd/MM/yyyy às HH:mm\\h"))</td>
                        <td>
                            <form style="display: inline;" method="post" asp-action="ExcluirParticipacao" id="formExcluir_@participacao.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@participacao.Id" />
                                <input type="hidden" name="idEvento" value="@Model.Evento.Id" />
                                @if (Model.SubEvento != null)
                                {
                                    <input type="hidden" name="idSubEvento" value="@Model.SubEvento.Id" />
                                }
                                <button type="button"
                                        class="btn btn-link text-danger p-0 btn-excluir-participacao"
                                        style="text-decoration: none;"
                                        data-form-id="formExcluir_@participacao.Id"
                                        data-nome="@participacao.IdPessoaNavigation?.Nome"
                                        data-tipo="@(participacao.Saida.HasValue ? "Saída" : "Entrada")"
                                        data-data="@(participacao.Saida.HasValue ? participacao.Saida.Value.ToString("dd/MM/yyyy 'às' HH:mm") : participacao.Entrada.ToString("dd/MM/yyyy 'às' HH:mm"))">
                                    Excluir
                                </button>
                            </form>
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-row-reverse mt-3">
    <div class="form-group">
        @if (User.IsInRole("GESTOR") || User.IsInRole("ADMINISTRADOR"))
        {
            <a asp-controller="Evento" asp-action="GerenciarEvento" asp-route-idEvento="@Model.Evento.Id" class="btn btn-lg btn-blue-normal">Voltar</a>
        }
        else if (User.IsInRole("COLABORADOR"))
        {
            <a asp-controller="Evento" asp-action="GerenciarEventoListar" class="btn btn-lg btn-blue-normal">Voltar</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-lg btn-blue-normal">Voltar</a>
        }
    </div>
</div>

<div class="modal fade" id="modalExcluirParticipacao" tabindex="-1" role="dialog" aria-labelledby="modalExcluirParticipacaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white position-relative">
                <h5 class="modal-title w-100 text-center fw-bold" id="modalExcluirParticipacaoLabel">Confirmar remoção</h5>
                <button type="button" class="btn-close btn-close-white position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <h5 class="fs-5 fw-normal mb-3">
                    Tem certeza que deseja remover a participação de
                    "<strong id="nomeParticipanteExcluir"></strong>"?
                </h5>
                <p class="text-muted small mb-2" id="detalheParticipacaoExcluir"></p>
                <span class="text-danger fw-bold small">
                    Essa operação não pode ser desfeita.
                </span>
            </div>
            <div class="modal-footer justify-content-center border-top-0 pt-0 pb-4">
                <button type="button" class="btn btn-primary px-4 me-2" data-bs-dismiss="modal">Não</button>
                <button type="button" class="btn btn-danger px-4" id="confirmRemovalButton">Sim</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Importar CSV -->
<div class="modal fade" id="modalImportarCsv" tabindex="-1" aria-labelledby="modalImportarCsvLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formImportarCsv" asp-action="ImportarCsv" asp-controller="ParticipacaoPessoaEvento" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEvento" value="@Model.Evento.Id" />
                @if (Model.SubEvento != null)
                {
                    <input type="hidden" name="idSubEvento" value="@Model.SubEvento.Id" />
                }
                <input type="hidden" name="actionRetorno" value="Index" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalImportarCsvLabel">Importar Planilha de Participantes</h5>
                    <button type="button" id="btnFecharModalImportarCsv" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Selecione o arquivo de planilha (formatos <code>.csv</code>, <code>.xlsx</code> ou <code>.xls</code>, como o relatório do SIGAA) para importar os participantes e registrar a presença.</p>
                    <div class="mb-3">
                        <label for="arquivoPlanilha" class="form-label">Arquivo de Planilha</label>
                        <input type="file" id="arquivoPlanilha" name="arquivoPlanilha" class="form-control" accept=".csv,.xlsx,.xls" required />
                    </div>
                    <div id="statusCarregamentoImportacao" class="d-none text-center py-3">
                        <div class="spinner-border text-primary mb-2" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <div class="small text-muted fw-semibold">Processando planilha e registrando presença, aguarde...</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnCancelarImportarCsv" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnSubmitImportarCsv" class="btn btn-primary">Importar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/datatable/js/datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaParticipacao').DataTable({
                language: {
                    url: '@Url.Content("~/lib/datatable/js/pt-BR.json")'
                },
                order: [[2, 'desc']], // Ordena por data/hora decrescente
                columnDefs: [
                    { orderable: false, targets: 3 } // Desabilita ordenação na coluna de ações
                ]
            });

            // Máscara para CPF
            $('#cpf').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length <= 11) {
                    value = value.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
                    $(this).val(value);
                }
            });

            // Confirmação de exclusão: exibe nome e dados do registro antes de remover
            var formExcluirAtual = null;

           $(document).on('click', '.btn-excluir-participacao', function () {
                formExcluirAtual = document.getElementById($(this).data('form-id'));
                $('#nomeParticipanteExcluir').text($(this).data('nome'));
                $('#detalheParticipacaoExcluir').text('Registro de ' + $(this).data('tipo') + ' em ' + $(this).data('data'));
                new bootstrap.Modal(document.getElementById('modalExcluirParticipacao')).show();
            });

            $('#confirmRemovalButton').on('click', function () {
                if (formExcluirAtual) {
                    formExcluirAtual.submit();
                }
            });

            // Animação de carregamento e prevenção de duplo envio na importação de planilha
            $('#formImportarCsv').on('submit', function () {
                var fileInput = document.getElementById('arquivoPlanilha');
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    return;
                }
                $('#btnSubmitImportarCsv')
                    .prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Importando...');
                $('#btnCancelarImportarCsv, #btnFecharModalImportarCsv').prop('disabled', true);
                $('#statusCarregamentoImportacao').removeClass('d-none');
            });
        });
    </script>
}