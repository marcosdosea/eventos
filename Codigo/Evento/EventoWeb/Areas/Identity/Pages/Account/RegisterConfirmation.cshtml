@page
@using EventoWeb.Models
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação de cadastro";
    var cpf = Request.Query["cpf"].ToString();
}

<h1 class="blue-normal">@ViewData["Title"]</h1>


<partial name="_RegistraConfirmacao" 
         model="new ConfirmaUserModel { Email = Model.Email, Cpf = @cpf }" />