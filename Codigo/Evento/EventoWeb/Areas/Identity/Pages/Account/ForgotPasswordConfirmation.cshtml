@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmação de recuperação de senha";
}

<h1>@ViewData["Title"]</h1>
<p>
    Por favor, verifique seu e-mail para redefinir sua senha.
</p>
<p class="mt-3">
    <a asp-page="./Login" class="btn btn-primary">Voltar para o Login</a>
</p>
